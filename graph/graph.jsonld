  {
   "@id": "https://github.com/john1hsu/usa-graph/id/slavery-in-the-united-states/misconception",
   "@type": "uso:Misconception",
   "uso:fact": "Slavery was legal in the North too; enslaved people were 30 percent of Kings County (Brooklyn) residents in 1790, New York's final emancipation came only in 1827, and about 16 people in New Jersey were still legally enslaved in December 1865.",
   "uso:myth": "Slavery was a purely Southern institution that the North never practised.",
   "uso:why": "Treating slavery as only Southern hides how gradual and incomplete northern emancipation was, and how northern banks and merchants profited from the cotton economy."
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/slavery-in-the-united-states/review/1",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why did Virginia's 1662 law matter so much for slavery's growth?",
   "uso:answer": "It made a child's status follow the mother's rather than the father's, so every child of an enslaved woman was born enslaved; slavery became hereditary and could grow through births rather than only through imports.",
   "uso:questionFor": {
    "@id": "us:slavery-in-the-united-states"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/slavery-in-the-united-states/review/2",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "How did the enslaved population grow from about 700,000 in 1790 to nearly 4 million in 1860 even though importing enslaved people was banned from 1808?",
   "uso:answer": "Because children of enslaved mothers were born enslaved, the population grew through births, and the domestic slave trade then moved about a million people from the Upper South to the cotton-growing Deep South.",
   "uso:questionFor": {
    "@id": "us:slavery-in-the-united-states"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/slavery-in-the-united-states/review/3",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "How did slavery reach into the free states before the Civil War?",
   "uso:answer": "The Constitution's fugitive slave clause required people escaping bondage to be returned, and the Fugitive Slave Act of 1850 used federal commissioners without juries to send about 1,000 Black Americans South, provoking resistance in northern communities.",
   "uso:questionFor": {
    "@id": "us:slavery-in-the-united-states"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/slavery-in-the-united-states/timeline/1",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The English privateer White Lion lands about twenty captive Africans at Point Comfort, Virginia, and sells them for food.",
   "uso:date": {
    "@type": "xsd:gYearMonth",
    "@value": "1619-08"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/slavery-in-the-united-states/timeline/10",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "General Order No. 3 announces freedom in Galveston, Texas, the origin of Juneteenth.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1865-06-19"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/slavery-in-the-united-states/timeline/11",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The Thirteenth Amendment is ratified, abolishing slavery nationwide.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1865-12-06"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/slavery-in-the-united-states/timeline/12",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "New Jersey's governor signs a state constitutional amendment ending slavery there.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1866-01-23"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/slavery-in-the-united-states/timeline/2",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Virginia's General Assembly rules that a child is enslaved or free according to the mother's status, making slavery hereditary.",
