   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/huffman-prairie/timeline/7",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Wilbur flies about 24 miles in some 39 minutes, a world record.",
   "uso:date": {
