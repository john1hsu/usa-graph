    "@value": "1902-10-23"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/lattimer-massacre/timeline/7",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "A memorial boulder and state marker are dedicated at Lattimer; Cesar Chavez speaks.",
   "uso:date": {
