   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/slavery-in-the-united-states/timeline/4",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Pennsylvania passes a gradual emancipation law.",
