   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/susan-b-anthony/misconception",
   "@type": "uso:Misconception",
   "uso:fact": "Some New Jersey women voted from 1776 until an 1807 law limited the vote to free white men, and women in Wyoming Territory (1869) and Utah Territory (1870) were enfranchised before her vote. In Rochester she registered with her three sisters and roughly ten other women, and warrants were issued for all of them, though only she was tried.",
   "uso:myth": "Susan B. Anthony was the first woman to vote in the United States, casting a lone ballot in Rochester in 1872.",
   "uso:why": "Her arrest, trial and refusal to pay the fine made her the public face of the 1872 protest, so the other Rochester voters and the earlier history of women voting dropped out of the popular story."
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/susan-b-anthony/review/1",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why could Anthony not take her 1873 conviction to the Supreme Court?",
   "uso:answer": "The law gave her no right of appeal, and because Justice Hunt fined her but did not jail her, she could not seek a writ of habeas corpus either; she refused to pay the $100 fine, and it was never collected.",
   "uso:questionFor": {
    "@id": "us:susan-b-anthony"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/susan-b-anthony/review/2",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "How did the Fifteenth Amendment divide Anthony from allies such as Frederick Douglass?",
   "uso:answer": "It barred racial but not sex discrimination in voting; Douglass supported it, while Anthony and Stanton opposed an amendment that left women out and formed the National Woman Suffrage Association to seek a federal woman suffrage amendment, at times using racist arguments that historians criticize.",
   "uso:questionFor": {
    "@id": "us:susan-b-anthony"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/susan-b-anthony/review/3",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why is the Nineteenth Amendment often called the Susan B. Anthony Amendment?",
   "uso:answer": "It grew out of the woman suffrage amendment that Senator Aaron Sargent introduced in her name in 1878, after her National Woman Suffrage Association returned to petitioning Congress, and which she campaigned for until her death; it was ratified in 1920, fourteen years after she died.",
   "uso:questionFor": {
    "@id": "us:susan-b-anthony"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/susan-b-anthony/timeline/1",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Born in Adams, Massachusetts, to Daniel and Lucy Anthony.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1820-02-15"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/susan-b-anthony/timeline/10",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Votes in the presidential and congressional election.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1872-11-05"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/susan-b-anthony/timeline/11",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Arrested at her Rochester home for voting illegally under the Enforcement Act of 1870.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1872-11-18"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/susan-b-anthony/timeline/12",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "A federal judge in Albany refuses to discharge her on a writ of habeas corpus.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1873-01-21"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/susan-b-anthony/timeline/13",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "A federal grand jury indicts her.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1873-01-24"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/susan-b-anthony/timeline/14",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Justice Ward Hunt directs a guilty verdict in Canandaigua and fines her $100, which she refuses to pay.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1873-06-18"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/susan-b-anthony/timeline/15",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Reads a Declaration of Rights of Women outside Independence Hall during the Centennial.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1876-07-04"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/susan-b-anthony/timeline/16",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Senator Aaron Sargent introduces the woman suffrage amendment that suffragists later call the Anthony Amendment.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1878-01-10"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/susan-b-anthony/timeline/17",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The first volume of the History of Woman Suffrage, by Stanton, Anthony and Matilda Joslyn Gage, is published.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1881"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/susan-b-anthony/timeline/18",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The rival suffrage associations merge as the National American Woman Suffrage Association.",
