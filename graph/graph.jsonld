    "@value": "1784-10"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/articles-of-confederation/timeline/11",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Delegates from several states gather at the Annapolis Convention.",
