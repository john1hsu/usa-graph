   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/war-of-1812/timeline/15",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The Royal Navy begins a 25-hour bombardment of Fort McHenry at Baltimore, which Francis Scott Key watches.",
