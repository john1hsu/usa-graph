  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/liberty-bell/timeline/13",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "For the Bicentennial the bell moves from Independence Hall to a glass-and-brick pavilion a block away.",
   "uso:date": {
