   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/martin-luther-king-jr/misconception",
   "@type": "uso:Misconception",
   "uso:fact": "In an August 1966 Gallup survey, 63% of Americans viewed King unfavorably, 44% highly so; by August 2011 Gallup found 94% favorable.",
   "uso:myth": "King was a widely admired, broadly popular figure in his own lifetime.",
   "uso:why": "Remembering King only as a unifying icon hides how controversial his demands for desegregation, voting rights, economic justice and an end to the Vietnam War were when he made them."
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/martin-luther-king-jr/review/1",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why did King's 1963 Birmingham campaign matter for national civil rights law?",
   "uso:answer": "Televised images of police violence against demonstrators in May 1963 pressured the Kennedy administration, which then proposed major civil rights legislation; President Johnson signed a civil rights law the following year.",
   "uso:questionFor": {
    "@id": "us:martin-luther-king-jr"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/martin-luther-king-jr/review/2",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "How did King's standing with the public and the federal government change after 1965, and why?",
   "uso:answer": "His Chicago campaign against housing discrimination brought no significant gains, and his 1967 Riverside Church speech against the Vietnam War cost him influence on federal racial policy and drew more FBI scrutiny; by August 1966 a Gallup poll found 63% of Americans viewed him unfavorably.",
   "uso:questionFor": {
    "@id": "us:martin-luther-king-jr"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/martin-luther-king-jr/review/3",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why did the Justice Department in 2000 reject the conspiracy finding of the 1999 King v. Jowers civil verdict?",
   "uso:answer": "It found the allegations of Loyd Jowers and Donald Wilson not credible because both men contradicted themselves and nothing reliable corroborated them, and it judged that the civil trial rested heavily on hearsay, so it saw no reason to disturb the 1969 finding that James Earl Ray killed King.",
   "uso:questionFor": {
    "@id": "us:martin-luther-king-jr"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/martin-luther-king-jr/timeline/1",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Born Michael King Jr. in Atlanta, Georgia; in 1934 his father changes both their names to Martin Luther King.",
   "uso:date": {
