   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/sojourner-truth/misconception",
   "@type": "uso:Misconception",
   "uso:fact": "The refrain, the dialect and the thirteen children come from Frances Dana Gage's version published in 1863, twelve years later. Marius Robinson's account, printed within weeks of the convention, has no such refrain; Truth, raised in New York speaking Dutch, never lived in the South, and she had five children.",
   "uso:myth": "At Akron in 1851 Sojourner Truth gave a speech in Southern dialect, repeating \"Ain't I a woman?\" and telling how she had borne thirteen children, most sold into slavery.",
   "uso:why": "Gage's dramatic version was reprinted widely, entered later editions of Truth's own Narrative and became the text schoolbooks quote, so the more reliable 1851 record was long overlooked."
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/sojourner-truth/review/1",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why do historians treat Marius Robinson's 1851 account of the Akron speech as more reliable than Frances Gage's 1863 version?",
   "uso:answer": "Robinson published his within weeks of the convention and is believed to have reviewed it with Truth, while Gage wrote twelve years later without Truth's review and put a Northern-born, Dutch-speaking woman's words into Southern dialect.",
   "uso:questionFor": {
    "@id": "us:sojourner-truth"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/sojourner-truth/review/2",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "How did New York law help Truth recover her son Peter in 1828?",
   "uso:answer": "New York's gradual-emancipation laws forbade selling an enslaved New Yorker out of state in a way that denied the person the benefits of those laws, so his sale to Alabama was illegal and she could sue for his return, which she won.",
   "uso:questionFor": {
    "@id": "us:sojourner-truth"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/sojourner-truth/review/3",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "How did Truth fund her work during the Civil War years?",
   "uso:answer": "She sold copies of her Narrative and cartes de visite of herself at lectures and by mail, registering a copyright in the photographs in 1864 so that the income came to her.",
   "uso:questionFor": {
    "@id": "us:sojourner-truth"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/sojourner-truth/timeline/1",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Born Isabella Baumfree, about this year, to James and Elizabeth Baumfree, enslaved in Ulster County, New York.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1797"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/sojourner-truth/timeline/10",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Moves to Harmonia, Michigan, near Battle Creek.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1857"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/sojourner-truth/timeline/11",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Frances Dana Gage publishes her dialect version of the Akron speech in The Independent.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1863-04-23"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/sojourner-truth/timeline/12",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Her copyright claim for cartes de visite titled \"I sell the Shadow to Support the Substance\" is recorded.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1864-02-16"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/sojourner-truth/timeline/13",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Meets President Abraham Lincoln at the White House while working for the National Freedman's Relief Association.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1864-10-29"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/sojourner-truth/timeline/14",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Campaigns for federal land grants to formerly enslaved people and meets President Ulysses S. Grant.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1870"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/sojourner-truth/timeline/15",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Dies at her home in Battle Creek, Michigan, and is buried in Oak Hill Cemetery.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1883-11-26"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/sojourner-truth/timeline/2",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Bought by John Dumont of West Park, New York, after being sold three times as a child.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1810"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/sojourner-truth/timeline/3",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Dumont breaks his promise to free her; she leaves with her infant daughter Sophia and is taken in by the Van Wagenen family.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1826"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/sojourner-truth/timeline/4",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "New York's emancipation law takes effect.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1827-07-04"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/sojourner-truth/timeline/5",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Wins People v. Solomon Gedney in New York's courts, recovering her son Peter, who had been illegally sold to Alabama.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1828"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/sojourner-truth/timeline/6",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Takes the name Sojourner Truth and begins travelling to preach and speak against slavery.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1843-06-01"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/sojourner-truth/timeline/7",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The Narrative of Sojourner Truth, dictated to Olive Gilbert, is published.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1850"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/sojourner-truth/timeline/8",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Speaks at the Woman's Rights Convention in Akron, Ohio.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1851-05-29"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/sojourner-truth/timeline/9",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Marius Robinson's account of her Akron speech appears in the Anti-Slavery Bugle.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1851-06-21"
   }
  },
