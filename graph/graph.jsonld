  {
   "@id": "https://github.com/john1hsu/usa-graph/id/indian-removal-act/timeline/5",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "After passing the Senate 28 to 19 and the House 102 to 97, the Indian Removal Act is signed by President Jackson.",
   "uso:date": {
