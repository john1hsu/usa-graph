  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/new-deal/timeline/7",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "In the Schechter case the Supreme Court strikes down the National Industrial Recovery Act.",
