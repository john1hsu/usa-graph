   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/department-of-homeland-security/timeline/6",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The Senate passes the amended bill, 90–9; the House agrees to it on November 22.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "2002-11-19"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/department-of-homeland-security/timeline/7",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Bush signs the Homeland Security Act of 2002 (Public Law 107-296).",
