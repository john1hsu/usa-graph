  {
   "@id": "https://github.com/john1hsu/usa-graph/id/frederick-douglass/misconception",
   "@type": "uso:Misconception",
   "uso:fact": "No record gives the day. Douglass believed he was born about 1817; a ledger kept by his enslaver Aaron Anthony notes February 1818, possibly added later, and Douglass chose February 14 to celebrate.",
   "uso:myth": "Douglass was born on February 14, 1818, a birthday recorded at the time.",
   "uso:why": "Enslaved people were routinely denied knowledge of their own birthdays, and the uncertainty is itself evidence of what slavery took from them."
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/frederick-douglass/review/1",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why did publishing his Narrative in 1845 put Douglass in danger, and how was that danger resolved?",
   "uso:answer": "The book named the people and places of his enslavement, exposing him as a fugitive who could be seized; he toured Britain and Ireland, where supporters raised $711.66 to buy his freedom from Hugh Auld, so he returned to the United States legally free in 1847.",
   "uso:questionFor": {
    "@id": "us:frederick-douglass"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/frederick-douglass/review/2",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "How did Douglass's view of the Constitution change, and why does it matter?",
   "uso:answer": "He first held William Lloyd Garrison's view that the Constitution was a proslavery compact, but between about 1848 and 1852 came to read it as an antislavery document; that let him work through politics and the law against slavery and broke his alliance with Garrison.",
   "uso:questionFor": {
    "@id": "us:frederick-douglass"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/frederick-douglass/review/3",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why did Douglass support the Fifteenth Amendment even though it did not enfranchise women?",
   "uso:answer": "He backed women's suffrage, but argued in 1869 that for Black Americans in the former slave states the vote was a matter of life and death, so Black men's voting rights could not wait for a separate women's amendment.",
   "uso:questionFor": {
    "@id": "us:frederick-douglass"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/frederick-douglass/timeline/1",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Born Frederick Augustus Washington Bailey in Talbot County, Maryland, according to a later ledger notation; he himself believed he was born about 1817.",
   "uso:date": {
    "@type": "xsd:gYearMonth",
    "@value": "1818-02"
   }
  },
