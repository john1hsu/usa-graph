  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/japanese-american-incarceration/timeline/4",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Public Law 503 makes violating an exclusion order a federal crime.",
