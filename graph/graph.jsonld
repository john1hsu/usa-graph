   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/tribal-sovereignty/timeline/7",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Public Law 280 shifts criminal and civil jurisdiction on most reservations in five states to state authorities.",
