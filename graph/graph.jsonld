   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/deepwater-horizon-oil-spill/timeline/11",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The presidential commission releases its final report, Deep Water.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "2011-01-11"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/deepwater-horizon-oil-spill/timeline/12",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "BP Exploration and Production is sentenced to $4 billion in criminal fines and penalties after pleading guilty.",
