   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/japanese-american-incarceration/timeline/12",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "A federal court in San Francisco vacates Fred Korematsu's conviction, citing government misconduct.",
   "uso:date": {
