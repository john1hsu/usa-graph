    "@value": "1898-03-02"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/lattimer-massacre/timeline/5",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "A UMW-led anthracite strike of about 125,000 workers ends.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1900-10-29"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/lattimer-massacre/timeline/6",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Miners return to work after the five-month anthracite strike of 1902.",
   "uso:date": {
