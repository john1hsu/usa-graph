   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/indian-removal-act/timeline/6",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Jackson tells Congress that removal is nearing a 'happy consummation' and that two nations have agreed to terms.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1830-12-06"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/indian-removal-act/timeline/7",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The Supreme Court in Cherokee Nation v. Georgia calls the Cherokees a 'domestic dependent nation' and declines to hear their suit; Choctaw removal begins.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1831"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/indian-removal-act/timeline/8",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "In Worcester v. Georgia the Court rules that Georgia's laws have no force in Cherokee territory; Georgia and the president do not enforce the ruling.",
   "uso:date": {
