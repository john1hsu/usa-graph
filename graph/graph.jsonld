   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/judicial-review/timeline/5",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "In Scott v. Sandford the Court strikes down the Missouri Compromise, the next federal statute it holds unconstitutional.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1857"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/judicial-review/timeline/6",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Abraham Lincoln's first inaugural address argues that Court rulings bind the parties but should not irrevocably fix national policy.",
   "uso:date": {
