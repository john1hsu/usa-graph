  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/blues/timeline/15",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The U.S. Senate marks the centennial of Handy's Tutwiler encounter by declaring 2003 the Year of the Blues.",
   "uso:date": {
