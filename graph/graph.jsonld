   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/frederick-douglass/timeline/15",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Dies at Cedar Hill, his Washington home, after attending a meeting of the National Council of Women.",
