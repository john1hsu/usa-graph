   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/lawes-divine-morall-and-martiall/timeline/7",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The first General Assembly meets at Jamestown and begins making laws for the colony's civilian government.",
