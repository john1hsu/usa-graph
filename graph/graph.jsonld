   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/fourteenth-amendment/timeline/13",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The Indian Citizenship Act makes Native Americans U.S. citizens.",
