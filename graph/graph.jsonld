   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/triangle-shirtwaist-factory-fire/timeline/8",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Blanck is fined $20 for locking a factory door during working hours at another shop.",
   "uso:date": {
