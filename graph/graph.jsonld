  {
   "@id": "https://github.com/john1hsu/usa-graph/id/deepwater-horizon-oil-spill/timeline/14",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "A federal court enters the consent decree, including up to $8.8 billion for natural resource damages.",
