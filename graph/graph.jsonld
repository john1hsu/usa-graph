   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/liberty-bell/timeline/9",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The bell travels to the World's Industrial and Cotton Centennial Exposition in New Orleans, the first of seven trips.",
   "uso:date": {
