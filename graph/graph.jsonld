  {
   "@id": "https://github.com/john1hsu/usa-graph/id/thomas-jefferson/misconception",
   "@type": "uso:Misconception",
   "uso:fact": "The Thomas Jefferson Foundation finds no such line in his writings; the earliest known printing of the wording is John L. O'Sullivan's 1837 introduction to the Democratic Review, and the earliest known attribution to Jefferson dates only from 1853.",
   "uso:myth": "Thomas Jefferson wrote that the government is best which governs least.",
   "uso:why": "The phrase was long associated with the political heirs of Jefferson's Democratic-Republican party, so it drifted onto the party's founder, and a familiar name makes a slogan sound authoritative."
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/thomas-jefferson/review/1",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why did the House of Representatives, not the voters or the electors, decide the presidential election of 1800?",
   "uso:answer": "Electors then cast two undifferentiated votes, so Jefferson and his running mate Aaron Burr tied at 73 electoral votes each; the Federalist-controlled House deadlocked for 35 ballots before choosing Jefferson on the 36th, on February 17, 1801.",
   "uso:questionFor": {
    "@id": "us:thomas-jefferson"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/thomas-jefferson/review/2",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "How did the Louisiana Purchase test Jefferson's own reading of the Constitution?",
   "uso:answer": "Jefferson doubted that the Constitution gave the president power to acquire territory and considered an amendment, but public support and the land's value led him to set aside his strict reading, a choice that helped build the principle of implied federal powers.",
   "uso:questionFor": {
    "@id": "us:thomas-jefferson"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/thomas-jefferson/review/3",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "How did Jefferson's 1803 letter to William Henry Harrison propose to obtain Native land?",
   "uso:answer": "He proposed government trading houses that would draw Native leaders into debt, which they would pay off by ceding land, and he expected Native nations either to be absorbed as citizens or to move west of the Mississippi.",
   "uso:questionFor": {
    "@id": "us:thomas-jefferson"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/thomas-jefferson/timeline/1",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Born at Shadwell plantation in western Virginia.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1743-04-13"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/thomas-jefferson/timeline/10",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The House of Representatives elects him president on its 36th ballot, breaking a 73-73 electoral tie with Aaron Burr.",
   "uso:date": {
