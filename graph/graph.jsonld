   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/okies/timeline/9",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Oklahoma governor Dewey Bartlett launches the OKIE campaign to turn the old insult into a badge of state pride.",
   "uso:date": {
