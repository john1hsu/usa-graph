   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/blues/timeline/2",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Bandleader W. C. Handy settles in Clarksdale, Mississippi, and around this year hears a slide guitarist playing a blues at the Tutwiler railroad station.",
   "uso:date": {
