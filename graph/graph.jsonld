    "@value": "1848"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/susan-b-anthony/timeline/4",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Amelia Bloomer introduces her to Elizabeth Cady Stanton in Seneca Falls, New York.",
