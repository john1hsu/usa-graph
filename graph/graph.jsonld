  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/liberty-bell/timeline/14",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The bell moves to a new building at Sixth and Market Streets, beside the site where Washington held enslaved people in the 1790s.",
   "uso:date": {
