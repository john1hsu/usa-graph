    "@value": "2013-06-11"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/jamestown/timeline/2",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "104 English men and boys choose a site on the James River and name it for the king.",
