   "@id": "https://github.com/john1hsu/usa-graph/id/harriet-tubman/timeline/13",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Congress passes H.R. 4982, raising her pension to $20 a month in recognition of her service as an army nurse.",
   "uso:date": {
