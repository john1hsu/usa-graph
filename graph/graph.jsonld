   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/harriet-tubman/timeline/14",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The AME Zion Church opens the Harriet Tubman Home for aged and poor African Americans on land she had transferred to it in 1903.",
   "uso:date": {
