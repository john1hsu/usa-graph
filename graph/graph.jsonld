    "@value": "1992"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/census-and-apportionment/timeline/13",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The Census Bureau delivers 2020 apportionment counts; Texas gains two seats and seven states lose one.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "2021-04-26"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/census-and-apportionment/timeline/2",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "U.S. marshals and their deputies begin the first federal census, which counts 3,929,214 people.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1790-08-02"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/census-and-apportionment/timeline/3",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "George Washington casts the first presidential veto, rejecting a 120-seat apportionment bill as unconstitutional.",
   "uso:date": {
