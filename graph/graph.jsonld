  {
   "@id": "https://github.com/john1hsu/usa-graph/id/deepwater-horizon-oil-spill/timeline/13",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The Justice Department announces a $20.8 billion civil settlement with BP, the United States and five Gulf states.",
   "uso:date": {
