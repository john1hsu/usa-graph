   "rdfs:label": "Civil rights movement",
   "schema:endDate": {
    "@type": "xsd:gYear",
    "@value": "1968"
   },
   "schema:startDate": {
    "@type": "xsd:gYear",
    "@value": "1954"
   },
   "skos:altLabel": [
    "African American civil rights movement",
    "American civil rights movement"
   ],
   "skos:broader": {
    "@id": "us:african-american-history"
   },
   "skos:definition": "The mass struggle, led and sustained above all by Black Americans, to end legal segregation and racial discrimination and secure equal citizenship and voting rights; its best-known phase ran from the mid-1950s to 1968 and produced the Civil Rights Act of 1964, the Voting Rights Act of 1965 and the Fair Housing Act of 1968.",
   "skos:inScheme": {
