    "@value": "1948"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/winged-figures-of-the-republic/timeline/6",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Hansen supervises a rebuilding of the terrazzo floor.",
   "uso:date": {
