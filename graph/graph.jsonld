  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/huffman-prairie/timeline/2",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The brothers first use a weight-and-derrick catapult to launch the Flyer in the prairie's light winds.",
   "uso:date": {
