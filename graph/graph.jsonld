  {
   "@id": "https://github.com/john1hsu/usa-graph/id/declaration-of-independence/misconception",
   "@type": "uso:Misconception",
   "uso:fact": "Congress approved the text on July 4, but it ordered a parchment copy for signing only on July 19; most delegates signed on August 2, 1776, a few signed later that year, and Thomas McKean signed sometime after January 1777.",
   "uso:myth": "The delegates signed the Declaration of Independence on July 4, 1776.",
   "uso:why": "Later recollections by Jefferson and Adams placed the signing on July 4, and the copies printed that week carried only the names of John Hancock and Charles Thomson, so the date of approval and the act of signing blurred together in popular memory."
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/declaration-of-independence/review/1",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why did Congress cut Jefferson's passage blaming the king for the slave trade?",
   "uso:answer": "Jefferson recorded that it was struck to accommodate South Carolina and Georgia, which wanted the slave trade to continue, and that some Northern delegates were uneasy because Northern merchants had carried enslaved people; the deletion kept those delegations behind independence.",
   "uso:questionFor": {
    "@id": "us:declaration-of-independence"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/declaration-of-independence/review/2",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "How did declaring independence help the American war effort abroad?",
   "uso:answer": "France would consider a formal alliance only once the colonies declared independence, so the Declaration opened the way to recognition and to the 1778 Treaty of Alliance with France, followed by Dutch recognition in 1782 and British acknowledgement in the 1783 Treaty of Paris.",
   "uso:questionFor": {
    "@id": "us:declaration-of-independence"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/declaration-of-independence/review/3",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why is July 4 not the day the Declaration was signed?",
   "uso:answer": "July 4 was the day Congress approved the text; the signing copy was only ordered on July 19, and most delegates signed it on August 2, 1776, with others signing later.",
   "uso:questionFor": {
    "@id": "us:declaration-of-independence"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/declaration-of-independence/review/4",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "How did later reformers use the Declaration's language?",
   "uso:answer": "The women who met at Seneca Falls in 1848 modelled their Declaration of Sentiments on it, declaring that all men and women are created equal, and Frederick Douglass in 1852 measured the nation's celebration of independence against the slavery it still allowed.",
   "uso:questionFor": {
    "@id": "us:declaration-of-independence"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/declaration-of-independence/timeline/1",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Richard Henry Lee of Virginia moves in Congress that the colonies are, and ought to be, free and independent states.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1776-06-07"
   }
  },
