   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/california-gold-rush/timeline/8",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "California is admitted as the 31st state, free of slavery, as part of the Compromise of 1850.",
