   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/new-deal/timeline/2",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Days after Roosevelt declares a bank holiday, he signs the Emergency Banking Act hours after Congress first sees it.",
