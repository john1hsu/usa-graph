   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/minimum-wage/timeline/2",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Congress passes a minimum wage law for women and minors in the District of Columbia.",
   "uso:date": {
