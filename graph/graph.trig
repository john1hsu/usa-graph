  <https://github.com/john1hsu/usa-graph/id/pennsylvania/timeline/18> <https://github.com/john1hsu/usa-graph/ontology#date> "2020-04-01"^^<http://www.w3.org/2001/XMLSchema#date> .
  <https://github.com/john1hsu/usa-graph/id/pennsylvania/timeline/1> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://github.com/john1hsu/usa-graph/ontology#TimelineEntry> .
  <https://github.com/john1hsu/usa-graph/id/pennsylvania/timeline/1> <http://www.w3.org/2000/01/rdf-schema#label> "Swedes and Finns found New Sweden on the Delaware River, among Lenape communities already living on both banks." .
  <https://github.com/john1hsu/usa-graph/id/pennsylvania/timeline/1> <https://github.com/john1hsu/usa-graph/ontology#date> "1638"^^<http://www.w3.org/2001/XMLSchema#gYear> .
  <https://github.com/john1hsu/usa-graph/id/pennsylvania/timeline/2> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://github.com/john1hsu/usa-graph/ontology#TimelineEntry> .
  <https://github.com/john1hsu/usa-graph/id/pennsylvania/timeline/2> <http://www.w3.org/2000/01/rdf-schema#label> "Charles II grants William Penn the Charter of Pennsylvania, settling a debt owed to Penn's father." .
  <https://github.com/john1hsu/usa-graph/id/pennsylvania/timeline/2> <https://github.com/john1hsu/usa-graph/ontology#date> "1681-03-04"^^<http://www.w3.org/2001/XMLSchema#date> .
  <https://github.com/john1hsu/usa-graph/id/pennsylvania/timeline/3> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://github.com/john1hsu/usa-graph/ontology#TimelineEntry> .
  <https://github.com/john1hsu/usa-graph/id/pennsylvania/timeline/3> <http://www.w3.org/2000/01/rdf-schema#label> "Penn arrives on the Welcome; Philadelphia is laid out as the capital." .
  <https://github.com/john1hsu/usa-graph/id/pennsylvania/timeline/3> <https://github.com/john1hsu/usa-graph/ontology#date> "1682-10"^^<http://www.w3.org/2001/XMLSchema#gYearMonth> .
  <https://github.com/john1hsu/usa-graph/id/pennsylvania/timeline/4> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://github.com/john1hsu/usa-graph/ontology#TimelineEntry> .
  <https://github.com/john1hsu/usa-graph/id/pennsylvania/timeline/4> <http://www.w3.org/2000/01/rdf-schema#label> "The provincial Assembly adopts the Great Law." .
  <https://github.com/john1hsu/usa-graph/id/pennsylvania/timeline/4> <https://github.com/john1hsu/usa-graph/ontology#date> "1682-12-07"^^<http://www.w3.org/2001/XMLSchema#date> .
  <https://github.com/john1hsu/usa-graph/id/pennsylvania/timeline/5> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://github.com/john1hsu/usa-graph/ontology#TimelineEntry> .
  <https://github.com/john1hsu/usa-graph/id/pennsylvania/timeline/5> <http://www.w3.org/2000/01/rdf-schema#label> "The Charter of Privileges guarantees worship to anyone who acknowledges one almighty God; it stays in force until 1776." .
