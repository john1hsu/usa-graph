    "@value": "1787-09-28"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/constitutional-convention/timeline/11",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Delaware becomes the first state to ratify.",
   "uso:date": {
