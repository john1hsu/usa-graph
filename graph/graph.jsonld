    "@value": "1886"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/tribal-sovereignty/timeline/6",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "House Concurrent Resolution 108 announces the policy of terminating federal supervision of tribes.",
   "uso:date": {
