   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/roosevelt-corollary/timeline/3",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Theodore Roosevelt announces the corollary in his annual message to Congress.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1904-12-06"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/roosevelt-corollary/timeline/4",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "A U.S.-Dominican executive agreement gives the United States control of Dominican customhouses; critics say it bypasses the Senate.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1905-01-20"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/roosevelt-corollary/timeline/5",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "With Senate action on a treaty blocked, Roosevelt puts a customs receivership into effect by a modus vivendi.",
   "uso:date": {
