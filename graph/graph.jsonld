  {
   "@id": "https://github.com/john1hsu/usa-graph/id/huffman-prairie/misconception",
   "@type": "uso:Misconception",
   "uso:fact": "The 1903 flights were brief, straight-line hops; the brothers learned to turn, circle, bank and stay up for half an hour only at Huffman Prairie in 1904–1905, with the redesigned Flyer III.",
   "uso:myth": "The Wright brothers had a finished, practical airplane once they flew at Kitty Hawk in 1903.",
   "uso:why": "The single dramatic date of December 17, 1903, is easy to remember, while two seasons of unpublicized trial and error in an Ohio pasture drew little press attention."
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/huffman-prairie/review/1",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why did the Wrights need a catapult at Huffman Prairie when they had not needed one at Kitty Hawk?",
   "uso:answer": "The Ohio pasture lacked the Outer Banks' steady strong winds and sand hills, so the brothers built a falling-weight derrick to get the heavier Flyer up to flying speed.",
   "uso:questionFor": {
    "@id": "us:huffman-prairie"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/huffman-prairie/review/2",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "How did the experiments at Huffman Prairie change the Wrights' machine from a novelty into a practical airplane?",
   "uso:answer": "Through repeated flights and crashes they enlarged and moved the elevator, enlarged the rudder and gave the pilot separate control of it, so that the 1905 Flyer III could bank, circle, fly figure-eights and stay aloft for more than half an hour.",
   "uso:questionFor": {
    "@id": "us:huffman-prairie"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/huffman-prairie/review/3",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why did the Wrights stop flying after October 1905, just as they had succeeded?",
   "uso:answer": "They feared that public demonstrations would let others copy their design before their patent was secure and before they had a buyer, so they took the Flyer apart and did not fly again for nearly three years.",
   "uso:questionFor": {
    "@id": "us:huffman-prairie"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/huffman-prairie/timeline/1",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Before a dozen invited reporters, the Wrights' new Flyer II fails to leave the ground because of engine trouble.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1904-05-23"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/huffman-prairie/timeline/10",
   "@type": "uso:TimelineEntry",
