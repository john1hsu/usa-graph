  {
   "@id": "https://github.com/john1hsu/usa-graph/id/thanksgiving/misconception",
   "@type": "uso:Misconception",
   "uso:fact": "The 1621 event was a three-day harvest gathering that also reinforced a new diplomatic alliance between the Wampanoag and the English; neither surviving English account calls it a thanksgiving. The national holiday descends from later official proclamations, above all Lincoln's in 1863, and the familiar story of a friendly shared meal took hold only in the mid-1800s.",
   "uso:myth": "Americans have celebrated Thanksgiving every year since the Pilgrims and their friendly Indian neighbors held the \"first Thanksgiving\" in 1621.",
   "uso:why": "The storybook version leaves out the Wampanoag's own reasons for the alliance, the epidemics that had devastated their communities, and the colonization and violence that followed — which is why many Native people mark the day as one of mourning."
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/thanksgiving/review/1",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why did the Wampanoag ally with the Plymouth colonists in 1621, according to the Smithsonian's account?",
   "uso:answer": "Epidemics between 1616 and 1619 had killed up to 90 percent of New England's Native population, and the weakened Wampanoag also needed help against the rival Narragansett, so they agreed to a mutual-defense treaty; the alliance was driven by diplomacy more than friendship.",
   "uso:questionFor": {
    "@id": "us:thanksgiving"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/thanksgiving/review/2",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "How did Thanksgiving become a fixed annual national holiday rather than an occasional proclamation?",
   "uso:answer": "Sarah Josepha Hale campaigned for decades for a national day; Lincoln's 1863 proclamation set the last Thursday of November, and presidents kept proclaiming the day until Roosevelt's 1939 change caused confusion, after which Congress in 1941 fixed it by law on the fourth Thursday of November.",
   "uso:questionFor": {
    "@id": "us:thanksgiving"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/thanksgiving/review/3",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why did Congress choose the \"fourth\" rather than the \"last\" Thursday of November in 1941?",
   "uso:answer": "The Senate amended the House resolution so that the date would stay consistent in years when November has five Thursdays, the problem that had prompted the 1939 change.",
   "uso:questionFor": {
    "@id": "us:thanksgiving"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/thanksgiving/timeline/1",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Epidemics brought by Europeans begin sweeping coastal New England; by 1619 they have killed up to 90 percent of the region's Native people.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1616"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/thanksgiving/timeline/2",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Wampanoag leader Ousamequin (Massasoit) and about 90 men join the Plymouth colonists for a three-day harvest gathering, probably in late September or early October.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1621"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/thanksgiving/timeline/3",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "At Congress's request, George Washington proclaims Thursday, November 26, 1789, a day of public thanksgiving and prayer.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1789-10-03"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/thanksgiving/timeline/4",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Sarah Josepha Hale, editing the Ladies' Magazine in Boston, begins writing in favor of a national Thanksgiving.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1827"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/thanksgiving/timeline/5",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Abraham Lincoln proclaims the last Thursday of November a national day of thanksgiving, after a letter from Hale dated September 28.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1863-10-03"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/thanksgiving/timeline/6",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Congress makes Thanksgiving a holiday in the District of Columbia, leaving its date to the President.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1870"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/thanksgiving/timeline/7",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Franklin D. Roosevelt moves Thanksgiving to the second-to-last Thursday of November; states split over which date to observe.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1939"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/thanksgiving/timeline/8",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Roosevelt signs H.J. Res. 41, fixing Thanksgiving on the fourth Thursday of November from 1942.",
   "uso:date": {
