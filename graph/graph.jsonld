   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/shelby-county-v-holder/timeline/8",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The U.S. Commission on Civil Rights unanimously recommends that Congress restore preclearance.",
   "uso:date": {
