   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/liberty-bell/misconception",
   "@type": "uso:Misconception",
   "uso:fact": "The National Park Service finds no evidence the bell rang on July 4 or July 8, 1776; the July 4 story comes from George Lippard's 1847 fiction, and the crack that silenced the bell dates from the 1840s.",
   "uso:myth": "The Liberty Bell rang out on July 4, 1776, to announce the Declaration of Independence, and cracked doing so.",
   "uso:why": "Lippard's tale was retold as fact in books and schoolrooms, and it gave a beloved object a dramatic founding moment that the record does not supply."
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/liberty-bell/review/1",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why did abolitionists, rather than the Revolutionary generation, give the Liberty Bell its name?",
   "uso:answer": "The inscription from Leviticus 25:10, about proclaiming liberty to all inhabitants, went largely unnoticed during the Revolution. In the 1830s antislavery activists saw the gap between those words and the enslavement of millions, and the Anti-Slavery Record of February 1835 called the State House bell \"The Liberty Bell\" and said its peals were a mockery while slavery lasted.",
   "uso:questionFor": {
    "@id": "us:liberty-bell"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/liberty-bell/review/2",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "How did a Philadelphia bell become a national symbol between 1885 and 1918?",
   "uso:answer": "It traveled by rail to seven fairs and expositions between 1885 and 1915, drawing huge crowds along the way, and during World War I the government used it in Liberty Loan drives that raised more than $17 billion. These tours and campaigns turned a local relic into a symbol recognized across the country.",
   "uso:questionFor": {
    "@id": "us:liberty-bell"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/liberty-bell/review/3",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why is it uncertain whether the bell rang for the Declaration of Independence?",
   "uso:answer": "No record shows the bell ringing on July 4 or July 8, 1776, and the steeple was in poor condition. The National Park Service says there is no evidence, while historian Gary Nash writes that it is believed to have rung at the July 8 public reading; the July 4 version is Lippard's fiction.",
   "uso:questionFor": {
    "@id": "us:liberty-bell"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/liberty-bell/timeline/1",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Superintendents of the Pennsylvania State House order a bell of about 2,000 pounds from London, with a verse from Leviticus as its inscription.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1751-11-01"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/liberty-bell/timeline/10",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The bell leaves on its last journey, a tour of more than 10,000 miles to the Panama-Pacific Exposition in San Francisco.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1915-07-05"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/liberty-bell/timeline/11",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Pennsylvania suffragists first ring their replica Justice Bell at Independence Square after the Nineteenth Amendment.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1920-09-25"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/liberty-bell/timeline/12",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The National Park Service takes custody of the bell and Independence Hall.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1948"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/liberty-bell/timeline/13",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "For the Bicentennial the bell moves from Independence Hall to a glass-and-brick pavilion a block away.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1976"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/liberty-bell/timeline/14",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The bell moves to a new building at Sixth and Market Streets, beside the site where Washington held enslaved people in the 1790s.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "2003"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/liberty-bell/timeline/2",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The bell, cast at the Whitechapel foundry, cracks on its first test strike soon after arriving in Philadelphia.",
   "uso:date": {
    "@type": "xsd:gYearMonth",
    "@value": "1752-08"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/liberty-bell/timeline/3",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Philadelphia metalworkers John Pass and John Stow recast it; the bell face bears the date MDCCLIII.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1753"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/liberty-bell/timeline/4",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The bell rings in protest as a ship carrying stamped paper for the Stamp Act approaches.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1765"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/liberty-bell/timeline/5",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Fearing the British would melt it for munitions, Philadelphians hide it in Allentown's Zion Reformed Church; it returns in 1778.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1777"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/liberty-bell/timeline/6",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The American Anti-Slavery Society's Anti-Slavery Record calls it 'The Liberty Bell', the earliest known use of the name.",
   "uso:date": {
    "@type": "xsd:gYearMonth",
    "@value": "1835-02"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/liberty-bell/timeline/7",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Workers drill out a hairline crack before Washington's Birthday; a new fissure opens and the bell is silenced for good.",
   "uso:date": {
