   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/triangle-shirtwaist-factory-fire/timeline/7",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "A jury acquits Blanck and Harris.",
   "uso:date": {
