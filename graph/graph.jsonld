   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/tribal-sovereignty/timeline/5",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "United States v. Kagama upholds federal criminal laws on reservations as a power to protect dependent peoples.",
   "uso:date": {
