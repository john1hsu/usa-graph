   "rdfs:label": "Japanese American incarceration during World War II",
   "schema:endDate": {
    "@type": "xsd:date",
    "@value": "1946-03-20"
   },
   "schema:startDate": {
    "@type": "xsd:date",
    "@value": "1942-02-19"
   },
   "skos:altLabel": [
    "Incarceration of Japanese Americans",
    "Internment of Japanese Americans",
    "Japanese American incarceration",
    "Japanese American internment",
    "Japanese American relocation",
    "Mass removal of Japanese Americans"
   ],
   "skos:broader": {
    "@id": "us:world-war-ii-and-the-united-states"
   },
   "skos:definition": "The forced removal of people of Japanese ancestry from the U.S. West Coast under Executive Order 9066 and their imprisonment, without charges or trial, in War Relocation Authority camps and other sites from 1942 to 1946; about two-thirds of those held were U.S. citizens.",
   "skos:inScheme": {
