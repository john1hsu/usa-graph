   "@id": "https://github.com/john1hsu/usa-graph/id/martin-luther-king-jr/timeline/17",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Gives his last speech at Bishop Charles J. Mason Temple in Memphis while supporting striking sanitation workers.",
