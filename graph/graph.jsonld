  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/morrill-land-grant-college-act/timeline/9",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The Equity in Educational Land-Grant Status Act makes tribal colleges and universities land-grant institutions.",
