    "@value": "1972-09-10"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/lattimer-massacre/timeline/8",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The centennial is marked with new state markers and remarks in the Congressional Record.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1997-09-10"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/lattimer-massacre/timeline/9",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "University of Maryland archaeologists and local volunteers survey the massacre site with metal detectors.",
   "uso:date": {
