  <https://github.com/john1hsu/usa-graph/id/pennsylvania/timeline/12> <http://www.w3.org/2000/01/rdf-schema#label> "The state capital moves to Harrisburg, after a stay in Lancaster from 1799." .
  <https://github.com/john1hsu/usa-graph/id/pennsylvania/timeline/12> <https://github.com/john1hsu/usa-graph/ontology#date> "1812"^^<http://www.w3.org/2001/XMLSchema#gYear> .
  <https://github.com/john1hsu/usa-graph/id/pennsylvania/timeline/13> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://github.com/john1hsu/usa-graph/ontology#TimelineEntry> .
  <https://github.com/john1hsu/usa-graph/id/pennsylvania/timeline/13> <http://www.w3.org/2000/01/rdf-schema#label> "A new state constitution disenfranchises free African Americans." .
  <https://github.com/john1hsu/usa-graph/id/pennsylvania/timeline/13> <https://github.com/john1hsu/usa-graph/ontology#date> "1838"^^<http://www.w3.org/2001/XMLSchema#gYear> .
  <https://github.com/john1hsu/usa-graph/id/pennsylvania/timeline/14> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://github.com/john1hsu/usa-graph/ontology#TimelineEntry> .
  <https://github.com/john1hsu/usa-graph/id/pennsylvania/timeline/14> <http://www.w3.org/2000/01/rdf-schema#label> "Commercial oil production begins near Titusville." .
  <https://github.com/john1hsu/usa-graph/id/pennsylvania/timeline/14> <https://github.com/john1hsu/usa-graph/ontology#date> "1859"^^<http://www.w3.org/2001/XMLSchema#gYear> .
  <https://github.com/john1hsu/usa-graph/id/pennsylvania/timeline/15> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://github.com/john1hsu/usa-graph/ontology#TimelineEntry> .
  <https://github.com/john1hsu/usa-graph/id/pennsylvania/timeline/15> <http://www.w3.org/2000/01/rdf-schema#label> "Union forces under Meade defeat Lee's invading army at Gettysburg." .
  <https://github.com/john1hsu/usa-graph/id/pennsylvania/timeline/15> <https://github.com/john1hsu/usa-graph/ontology#date> "1863-07"^^<http://www.w3.org/2001/XMLSchema#gYearMonth> .
