   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/september-11-attacks/timeline/7",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The recovery effort at Ground Zero formally ends with the removal of the Last Column.",
   "uso:date": {
