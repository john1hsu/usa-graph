    "@value": "1865-01-31"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/thirteenth-amendment/timeline/6",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Lincoln approves the joint resolution sending the amendment to the states.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1865-02-01"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/thirteenth-amendment/timeline/7",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Georgia becomes the 27th state to ratify, completing the three-fourths needed.",
   "uso:date": {
