   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/hayden-geological-survey-of-1871/timeline/11",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Hayden dates his report on the season's work to Interior Secretary Delano.",
   "uso:date": {
