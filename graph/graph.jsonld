  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/constitutional-convention/timeline/2",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The convention's scheduled opening day; too few delegations are present, so members adjourn from day to day.",
   "uso:date": {
