  {
   "@id": "https://github.com/john1hsu/usa-graph/id/mccarthyism/misconception",
   "@type": "uso:Misconception",
   "uso:fact": "McCarthy was a senator who chaired a Senate subcommittee; HUAC was a House committee dating from 1938, it held its Hollywood hearings in 1947, and Truman's federal loyalty program began in March 1947, nearly three years before McCarthy's Wheeling speech.",
   "uso:myth": "Joseph McCarthy started the Red Scare and ran the House Un-American Activities Committee that blacklisted Hollywood.",
   "uso:why": "Naming a whole era after one senator hides how broad and bipartisan the anticommunist campaign was, and how much of it was carried out by agencies, employers, unions and state governments rather than by McCarthy himself."
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/mccarthyism/review/1",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why do historians such as Ellen Schrecker argue that McCarthyism was much bigger than Joseph McCarthy?",
   "uso:answer": "Federal loyalty reviews, HUAC investigations and the Hollywood blacklist were under way before McCarthy's 1950 Wheeling speech, and firings, loyalty oaths and screening programs continued after his 1954 censure; the repression worked through many public and private actors, from federal agencies to employers and unions, not one senator.",
   "uso:questionFor": {
    "@id": "us:mccarthyism"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/mccarthyism/review/2",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "How did the televised Army-McCarthy hearings contribute to McCarthy's downfall?",
   "uso:answer": "About 20 million people watched McCarthy's bullying tactics over 36 days in 1954, culminating in Joseph Welch's rebuke on June 9; his popularity collapsed, and in December the Senate voted 67 to 22 to censure him.",
   "uso:questionFor": {
    "@id": "us:mccarthyism"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/mccarthyism/review/3",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "How did the Venona decrypts change the debate over the era?",
   "uso:answer": "Released from 1995, they confirmed that some Americans, including Julius Rosenberg, really did spy for the Soviet Union; some historians argue this shows anticommunist fears had a real basis, while critics of McCarthyism reply that real espionage does not justify the false accusations and mass firings of people who were never spies.",
   "uso:questionFor": {
    "@id": "us:mccarthyism"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/mccarthyism/review/4",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why was the Lavender Scare part of the same era?",
   "uso:answer": "Anticommunists claimed that gay federal employees were morally weak and open to Soviet blackmail, so Eisenhower's 1953 Executive Order 10450 barred them from federal jobs, a ban not lifted in the civil service until 1975.",
   "uso:questionFor": {
    "@id": "us:mccarthyism"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/mccarthyism/timeline/1",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The House creates the Special Committee on Un-American Activities, known as the Dies Committee after its chair, Martin Dies Jr. of Texas.",
