    "@value": "1910-05"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/wright-company-school-of-aviation/timeline/4",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Walter Brookins flies solo for about 12 minutes, the Montgomery camp's only graduate.",
   "uso:date": {
