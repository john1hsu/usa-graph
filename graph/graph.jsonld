   "@id": "https://github.com/john1hsu/usa-graph/id/susan-b-anthony/timeline/21",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Dies at her home in Rochester; she is buried in Mount Hope Cemetery.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1906-03-13"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/susan-b-anthony/timeline/3",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Teaching in Canajoharie, New York, she learns that male teachers earn $10 a month and women $2.50.",
