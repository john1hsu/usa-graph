   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/abraham-lincoln/timeline/2",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "First elected to the Illinois legislature.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1834"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/abraham-lincoln/timeline/3",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "As a first-term Whig congressman, introduces the Spot Resolutions challenging the case for war with Mexico.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1847-12-22"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/abraham-lincoln/timeline/4",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Gives the \"House Divided\" speech; later loses the Senate race to Stephen A. Douglas.",
   "uso:date": {
