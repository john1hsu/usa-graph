  {
   "@id": "https://github.com/john1hsu/usa-graph/id/winged-figures-of-the-republic/misconception",
   "@type": "uso:Misconception",
   "uso:fact": "Monticello's research staff have found no evidence that Jefferson said or wrote it; the idea traces to John Philpot Curran, and the modern wording circulated in American newspapers without his name, first credited to Jefferson in print in 1834.",
   "uso:myth": "Thomas Jefferson coined the phrase \"eternal vigilance is the price of liberty,\" which Hansen invoked to explain his statues.",
   "uso:why": "Patriotic maxims tend to migrate to the most famous founder, and a phrase carved into civic memory, as at Hoover Dam, rarely carries its real source with it."
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/winged-figures-of-the-republic/review/1",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "How does the star map let a future viewer work out when Hoover Dam was dedicated?",
   "uso:answer": "Hansen laid out the positions of celestial bodies as they stood at the dam's dedication on September 30, 1935, and set them within a Circle of Precession showing the slow wobble of Earth's axis known as the Platonic Year, so the sky's arrangement fixes the moment even without a written date.",
   "uso:questionFor": {
    "@id": "us:winged-figures-of-the-republic"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/winged-figures-of-the-republic/review/2",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why do some catalogues date the figures to 1935 when the plaza was finished in 1938?",
   "uso:answer": "The Smithsonian's sculpture inventory ties the work to the dam's 1935 dedication, which the star map commemorates, but Reclamation photographs show Hansen still overseeing fabrication of the star map in April 1938, and the plaza was completed that year.",
   "uso:questionFor": {
    "@id": "us:winged-figures-of-the-republic"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/winged-figures-of-the-republic/review/3",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "How did the builders set the heavy bronze figures on their polished bases without scratching them?",
   "uso:answer": "The diorite bases were placed on blocks of ice and guided into position as the ice melted, avoiding scars to the polished stone and floor.",
   "uso:questionFor": {
    "@id": "us:winged-figures-of-the-republic"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/winged-figures-of-the-republic/review/4",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why did Hansen describe the figures in terms of vigilance, and what is wrong with crediting that idea to Jefferson?",
   "uso:answer": "Hansen said the figures stood for the eternal vigilance that is the price of liberty, casting them as sentries of the Republic; Monticello finds no evidence Jefferson ever said this, tracing it instead to John Philpot Curran.",
   "uso:questionFor": {
    "@id": "us:winged-figures-of-the-republic"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/winged-figures-of-the-republic/timeline/1",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "President Franklin D. Roosevelt dedicates the dam, then called Boulder Dam; Hansen's star map later records the sky at this moment.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1935-09-30"
   }
  },
