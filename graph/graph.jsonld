  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/liberty-bell/timeline/2",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The bell, cast at the Whitechapel foundry, cracks on its first test strike soon after arriving in Philadelphia.",
   "uso:date": {
