  {
   "@id": "https://github.com/john1hsu/usa-graph/id/chinese-exclusion-act/misconception",
   "@type": "uso:Misconception",
   "uso:fact": "The 1882 act suspended the entry of Chinese laborers, skilled and unskilled, while merchants, students, teachers, diplomats and travelers with certificates could still enter; the 1943 repeal replaced exclusion with a quota of about 105 people a year, and racial quotas lasted until 1965.",
   "uso:myth": "The Chinese Exclusion Act shut out every Chinese person, and its repeal in 1943 reopened immigration from China.",
   "uso:why": "Seeing exclusion as a class-and-race filter enforced through papers, interrogations and quotas explains why Chinese families relied on certificates and paper son identities, and why its effects outlasted the repeal."
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/chinese-exclusion-act/review/1",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why did President Arthur veto the first exclusion bill in April 1882, and how did the law he signed in May differ?",
   "uso:answer": "He argued that a twenty-year ban broke the 1880 treaty, which let the United States limit but not prohibit Chinese immigration, and objected to making Chinese residents register; the act he approved cut the suspension to ten years.",
   "uso:questionFor": {
    "@id": "us:chinese-exclusion-act"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/chinese-exclusion-act/review/2",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "How did the 1882 act lead to paper sons and daughters?",
   "uso:answer": "Because laborers were barred while merchants and their families could still enter with papers, many Chinese immigrants entered as paper sons and daughters, claiming family ties on paper to qualify for admission.",
   "uso:questionFor": {
    "@id": "us:chinese-exclusion-act"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/chinese-exclusion-act/review/3",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why did Congress repeal the exclusion laws in 1943, and why did the repeal not open immigration widely?",
   "uso:answer": "China was a wartime ally and Japanese propaganda used exclusion against the alliance; the repeal still set an ethnic quota of about 105 Chinese immigrants a year.",
   "uso:questionFor": {
    "@id": "us:chinese-exclusion-act"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/chinese-exclusion-act/timeline/1",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Chinese immigration to the United States begins in earnest with the California Gold Rush.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1849"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/chinese-exclusion-act/timeline/10",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Exclusion is made permanent.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1902"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/chinese-exclusion-act/timeline/11",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "During World War II Congress repeals the exclusion laws, sets a Chinese quota of about 105 a year and opens naturalization.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1943"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/chinese-exclusion-act/timeline/12",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The Immigration and Nationality Act ends the national-origins quota system.",
