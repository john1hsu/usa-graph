   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/japanese-american-incarceration/timeline/9",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The Supreme Court upholds exclusion in Korematsu v. United States but rules in Ex parte Endo that loyal citizens cannot be held.",
   "uso:date": {
