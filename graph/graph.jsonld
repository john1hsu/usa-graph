    "@value": "1831"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/tribal-sovereignty/timeline/3",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "In Worcester v. Georgia the Court holds that Georgia law has no force within the Cherokee Nation.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1832"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/tribal-sovereignty/timeline/4",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Congress forbids further treaty-making with tribes; more than 370 ratified treaties remain law.",
   "uso:date": {
