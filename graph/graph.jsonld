  {
   "@id": "https://github.com/john1hsu/usa-graph/id/chinese-detention-barracks-poetry/misconception",
   "@type": "uso:Misconception",
   "uso:fact": "Officials knew of the poems and had them repeatedly puttied and painted over, and two detainees copied nearly 200 of them in 1931–32; the 1970 find was a rediscovery. The walls also hold inscriptions in Japanese, Korean, Russian and other languages.",
   "uso:myth": "The poems lay forgotten until a park ranger stumbled on them by chance in 1970, and they are the only writing on the walls.",
   "uso:why": "The 1970 find launched the campaign that saved the barracks, so it became the story's starting point, and the Chinese poems' fame has overshadowed the other inscriptions."
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/chinese-detention-barracks-poetry/review/1",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why did detainees at Angel Island write poems on the barracks walls, and why are most of them unsigned?",
   "uso:answer": "Chinese men held for weeks, months or sometimes years while officials enforced the exclusion laws used the walls to voice homesickness, anger and despair; most did not sign or date their work, likely for fear of punishment by the authorities.",
   "uso:questionFor": {
    "@id": "us:chinese-detention-barracks-poetry"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/chinese-detention-barracks-poetry/review/2",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "How did the efforts of officials to erase the poems end up helping preserve them?",
   "uso:answer": "After brushed poems were painted over, detainees carved the characters into the wood; crews filled the carvings with putty and paint, which sealed the wood, and as the putty shrank and the paint cracked the poems reappeared.",
   "uso:questionFor": {
    "@id": "us:chinese-detention-barracks-poetry"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/chinese-detention-barracks-poetry/review/3",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why are no poems by women known, and how were some damaged poems recovered?",
   "uso:answer": "Women were held in the administration building, which burned in 1940, so any writing there was lost; poems copied by detainees Smiley Jann in 1931 and Tet Yee in 1932 were given to researchers in 1976 and helped them restore damaged or missing poems.",
   "uso:questionFor": {
    "@id": "us:chinese-detention-barracks-poetry"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/chinese-detention-barracks-poetry/review/4",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "How do scholars differ in reading the poems' form?",
   "uso:answer": "Him Mark Lai described them as largely in the classical Tang style, while R. John Williams argues their irregular rhythms and loose constructions sit closer to modern free verse than to the classics.",
   "uso:questionFor": {
    "@id": "us:chinese-detention-barracks-poetry"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/chinese-detention-barracks-poetry/timeline/1",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The U.S. Immigration Station on Angel Island opens; poems begin to appear on the barracks walls within about ten months.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1910-01-21"
   }
  },
