    "@value": "2012"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/chinese-exclusion-act/timeline/2",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The Burlingame Treaty secures free migration between the United States and China.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1868"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/chinese-exclusion-act/timeline/3",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The Page Act bars contract laborers, prostitutes and felons from China and Japan; its enforcement keeps most Chinese women out.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1875"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/chinese-exclusion-act/timeline/4",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The Angell Treaty allows the United States to regulate or limit, but not wholly prohibit, Chinese immigration.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1880"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/chinese-exclusion-act/timeline/5",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "President Chester A. Arthur vetoes a bill that would have suspended Chinese labor immigration for twenty years.",
   "uso:date": {
