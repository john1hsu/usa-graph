    "@value": "1965"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/chinese-exclusion-act/timeline/13",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Following a 2011 Senate resolution, the House unanimously adopts a resolution condemning the exclusion laws.",
   "uso:date": {
