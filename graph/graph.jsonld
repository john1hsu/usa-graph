   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/winged-figures-of-the-republic/timeline/7",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Visitor access to the plaza closes during the COVID-19 pandemic.",
