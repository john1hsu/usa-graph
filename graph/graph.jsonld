  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/frederick-douglass/timeline/2",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Sent to Baltimore to live with Hugh and Sophia Auld, where he begins learning to read.",
