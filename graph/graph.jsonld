   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/winged-figures-of-the-republic/timeline/8",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Reclamation contractors begin a full restoration; the figures are sandblasted and repatinated and the old star map is demolished to install drainage.",
