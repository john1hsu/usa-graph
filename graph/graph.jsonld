   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/abraham-lincoln/timeline/5",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Elected 16th president with a majority of electoral votes from the free states.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1860-11-04"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/abraham-lincoln/timeline/6",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Inaugurated after seven Southern states had seceded.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1861-03-04"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/abraham-lincoln/timeline/7",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Thirty-eight Dakota men are hanged at Mankato after Lincoln commutes most of the death sentences.",
   "uso:date": {
