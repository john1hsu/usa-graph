    "@value": "1846-02"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/liberty-bell/timeline/8",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "George Lippard's fictional story 'Ring, Grandfather, Ring' ties the bell to July 4, 1776.",
   "uso:date": {
    "@type": "xsd:gYear",
