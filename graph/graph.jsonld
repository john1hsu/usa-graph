    "@value": "1895"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/jazz/timeline/3",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Pianist and composer Jelly Roll Morton begins touring outside New Orleans.",
