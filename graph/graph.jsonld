   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/shelby-county-v-holder/timeline/9",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The Senate fails to invoke cloture on the John Lewis Voting Rights Advancement Act, which the House had passed.",
   "uso:date": {
