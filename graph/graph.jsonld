   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/war-of-1812/timeline/14",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "A U.S. naval victory on Lake Champlain leads British land forces to abandon their attack at Plattsburgh, New York.",
