    "@value": "1994-04-04"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/jamestown/timeline/16",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Archaeologists announce forensic evidence of survival cannibalism during the Starving Time.",
   "uso:date": {
