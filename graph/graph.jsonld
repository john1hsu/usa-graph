    "@type": "xsd:gYear",
    "@value": "1890"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/susan-b-anthony/timeline/19",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Becomes president of NAWSA, serving until Carrie Chapman Catt succeeds her in 1900.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1892"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/susan-b-anthony/timeline/2",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The Anthony family moves to a farm near Rochester, New York, where antislavery Quakers gather on Sundays.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1845"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/susan-b-anthony/timeline/20",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Attends her last NAWSA convention, in Baltimore, and gives her final public remarks.",
   "uso:date": {
    "@type": "xsd:gYearMonth",
    "@value": "1906-02"
   }
  },
