   "@id": "https://github.com/john1hsu/usa-graph/id/monroe-doctrine/timeline/3",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "British Foreign Minister George Canning proposes a joint U.S.-British declaration against European intervention in the Americas.",
   "uso:date": {
