   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/minimum-wage/timeline/11",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Under the 1966 amendments, farmworkers are covered by the federal minimum for the first time, at $1.00 an hour.",
   "uso:date": {
