    "@type": "xsd:date",
    "@value": "1837-03-03"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/supreme-court-of-the-united-states/timeline/8",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Chief Justice Roger B. Taney announces the Dred Scott decision.",
