   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/constitutional-convention/timeline/4",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Edmund Randolph presents the Virginia Plan, and the convention adopts a rule keeping its proceedings secret.",
