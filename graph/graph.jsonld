   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/september-11-attacks/timeline/8",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The Department of Homeland Security opens, combining parts or all of 22 federal agencies.",
   "uso:date": {
