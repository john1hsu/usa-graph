   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/wright-company-school-of-aviation/timeline/6",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Arthur L. Welsh, the school's first Dayton-trained pilot and later an instructor, is killed in a crash at College Park, Maryland.",
