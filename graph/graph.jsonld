   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/judicial-review/timeline/4",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Thomas Jefferson writes to Justice William Johnson criticizing Marbury and naming the people as the ultimate arbiter.",
   "uso:date": {
