   "@id": "https://github.com/john1hsu/usa-graph/id/jamestown/timeline/15",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Jamestown Rediscovery begins excavating and soon finds that James Fort survives on dry land.",
   "uso:date": {
