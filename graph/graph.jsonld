    "@value": "1882-04-04"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/chinese-exclusion-act/timeline/6",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Arthur approves a revised act suspending Chinese labor immigration for ten years and barring Chinese naturalization.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1882-05-06"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/chinese-exclusion-act/timeline/7",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The Scott Act voids the return certificates of Chinese laborers abroad, stranding about 20,000 people.",
   "uso:date": {
