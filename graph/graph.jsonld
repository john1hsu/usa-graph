  {
   "@id": "https://github.com/john1hsu/usa-graph/id/liberty-bell/timeline/12",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The National Park Service takes custody of the bell and Independence Hall.",
   "uso:date": {
