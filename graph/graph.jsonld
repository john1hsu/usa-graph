   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/wright-brothers-first-flight/timeline/9",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "President Calvin Coolidge signs the act creating the Kill Devil Hill National Memorial.",
