   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/census-and-apportionment/timeline/4",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Washington signs a replacement act giving the House 105 seats under Jefferson's method.",
