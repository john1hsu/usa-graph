  {
   "@id": "https://github.com/john1hsu/usa-graph/id/wright-brothers-first-flight/misconception",
   "@type": "uso:Misconception",
   "uso:fact": "The flights took off from the sand dunes at Kill Devil Hills, about four miles south of the village of Kitty Hawk; the brothers walked to Kitty Hawk afterwards to send the telegram announcing their success.",
   "uso:myth": "The Wright brothers first flew in the town of Kitty Hawk.",
   "uso:why": "Kitty Hawk was the nearest village — its weather station first invited the brothers and their telegram was sent from there — so its name travelled with the news."
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/wright-brothers-first-flight/review/1",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why did two Ohio bicycle makers test their aircraft on the North Carolina Outer Banks?",
   "uso:answer": "They wanted steady winds, hills, soft sand and few trees; of the weather stations they wrote to, only Kitty Hawk replied, and its weatherman Bill Tate offered to host them.",
   "uso:questionFor": {
    "@id": "us:wright-brothers-first-flight"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/wright-brothers-first-flight/review/2",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "How did the flight of December 17, 1903, differ from earlier hops and glides by other experimenters?",
   "uso:answer": "Others had glided or lifted off briefly, but the Wrights' Flyer took off under its own engine power and flew in sustained flight under the pilot's complete control — the first such demonstration of a heavier-than-air machine.",
   "uso:questionFor": {
    "@id": "us:wright-brothers-first-flight"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/wright-brothers-first-flight/review/3",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why did the 1903 Flyer spend twenty years outside the Smithsonian?",
   "uso:answer": "After Langley's death the Smithsonian displayed his rebuilt Aerodrome as the first airplane capable of sustained flight, based on modified 1914 tests by Glenn Curtiss; Orville sent the Flyer to London in protest and it returned only after the Smithsonian published a correction in 1942, arriving in 1948.",
   "uso:questionFor": {
    "@id": "us:wright-brothers-first-flight"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/wright-brothers-first-flight/timeline/1",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The Wrights begin testing gliders on the Outer Banks near Kitty Hawk, whose weather station had answered their inquiry about steady winds and open sand.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1900"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/wright-brothers-first-flight/timeline/10",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Amid a feud with the Smithsonian, Orville ships the 1903 Flyer to the Science Museum in London.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1928"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/wright-brothers-first-flight/timeline/11",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The Flyer is installed at the Smithsonian, 45 years to the day after it flew.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1948-12-17"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/wright-brothers-first-flight/timeline/2",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Wilbur glides 622 feet in 21 seconds, setting American distance and time records for gliders.",
   "uso:date": {
    "@type": "xsd:gYearMonth",
    "@value": "1902-10"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/wright-brothers-first-flight/timeline/3",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The brothers file their patent application for a \"Flying-Machine\".",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1903-03-23"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/wright-brothers-first-flight/timeline/4",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Samuel Langley's Smithsonian-backed Great Aerodrome crashes on its second launch attempt.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1903-12-08"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/wright-brothers-first-flight/timeline/5",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Wilbur wins a coin toss for the first try, but the Flyer stalls and noses into the sand.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1903-12-14"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/wright-brothers-first-flight/timeline/6",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Four powered flights from Kill Devil Hills; Orville flies 120 feet in 12 seconds, Wilbur 852 feet in 59 seconds.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1903-12-17"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/wright-brothers-first-flight/timeline/7",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The Wrights move their experiments to Huffman Prairie near Dayton with a sturdier new machine.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1904"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/wright-brothers-first-flight/timeline/8",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "U.S. Patent 821,393 for the Wrights' flying machine is granted.",
   "uso:date": {
