   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/census-and-apportionment/misconception",
   "@type": "uso:Misconception",
   "uso:fact": "The Bureau counts the population and applies a formula that Congress wrote into law (equal proportions, adopted in 1941); the states then redraw their own district lines using census redistricting data.",
   "uso:myth": "The Census Bureau decides how many House seats each state gets and draws the new congressional districts.",
   "uso:why": "Because seat gains and losses are announced by the Census Bureau, the count, the formula and the separate state-run redistricting process are easily blurred together."
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/census-and-apportionment/review/1",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why did the original apportionment formula give slaveholding states extra representation, and how did that change?",
   "uso:answer": "Article I counted enslaved people as three-fifths of a person for apportionment though they could not vote, adding seats for slaveholding states; after emancipation the Fourteenth Amendment (1868) counted the whole number of persons, which would have fully counted freed people and so increased Southern power, which is why it added a never-enforced penalty for denying men the vote.",
   "uso:questionFor": {
    "@id": "us:census-and-apportionment"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/census-and-apportionment/review/2",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why did Washington veto the first apportionment bill in 1792?",
   "uso:answer": "He judged it unconstitutional because no single ratio produced its allotment and it gave eight states more than one representative per 30,000 people, the Constitution's limit.",
   "uso:questionFor": {
    "@id": "us:census-and-apportionment"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/census-and-apportionment/review/3",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "How did the failure to reapportion after the 1920 census change the process?",
   "uso:answer": "Rural members, fearing a loss of power to fast-growing cities, blocked reapportionment for a decade; the 1929 act responded by making apportionment automatic after each census with the House kept at 435 seats.",
   "uso:questionFor": {
    "@id": "us:census-and-apportionment"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/census-and-apportionment/review/4",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "What is the difference between apportionment and redistricting?",
   "uso:answer": "Apportionment divides the 435 House seats among the states by population; redistricting is each state's redrawing of district boundaries within its borders, using small-area counts the Census Bureau supplies.",
   "uso:questionFor": {
    "@id": "us:census-and-apportionment"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/census-and-apportionment/timeline/1",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The Constitutional Convention votes to tie representation and direct taxes to population, counting enslaved people at three-fifths.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1787-07-12"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/census-and-apportionment/timeline/10",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The Attorney General concludes that no American Indians remain 'not taxed' for census purposes.",
   "uso:date": {
