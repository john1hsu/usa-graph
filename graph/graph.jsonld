   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/slavery-in-the-united-states/timeline/9",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The census counts 3,953,760 enslaved people, the peak and the last census to count them.",
