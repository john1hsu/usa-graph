  {
   "@id": "https://github.com/john1hsu/usa-graph/id/war-of-1812/timeline/6",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "USS Constitution defeats HMS Guerriere and earns the nickname 'Old Ironsides'.",
