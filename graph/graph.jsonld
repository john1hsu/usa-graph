  {
   "@id": "https://github.com/john1hsu/usa-graph/id/thirteenth-amendment/misconception",
   "@type": "uso:Misconception",
   "uso:fact": "The 1863 proclamation applied only to areas in rebellion and left slavery legal in loyal border states; slavery ended nationwide only with the Thirteenth Amendment, which freed people still enslaved in Delaware and Kentucky in December 1865.",
   "uso:myth": "The Emancipation Proclamation ended slavery throughout the United States.",
   "uso:why": "Confusing a wartime executive order with a constitutional amendment hides why abolitionists, Congress and Lincoln fought for an amendment, and how close slavery came to surviving the war."
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/thirteenth-amendment/review/1",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why did Lincoln and Congress believe a constitutional amendment was needed even after the Emancipation Proclamation?",
   "uso:answer": "The proclamation rested on Lincoln's war powers and applied only to areas in rebellion, not to loyal border states; its legal force after the war was doubtful, so an amendment was the only secure way to end slavery everywhere.",
   "uso:questionFor": {
    "@id": "us:thirteenth-amendment"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/thirteenth-amendment/review/2",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "How did the 1864 election and the end of the war help the amendment pass and be ratified?",
   "uso:answer": "After the House first failed to reach two-thirds, Lincoln's reelection campaign put the amendment on the Republican platform and a lame-duck session passed it in January 1865; later, President Andrew Johnson required Southern states seeking readmission to abolish slavery, and Georgia's ratification in December 1865 completed the three-fourths.",
   "uso:questionFor": {
    "@id": "us:thirteenth-amendment"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/thirteenth-amendment/review/3",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why is the amendment's exception \"as a punishment for crime\" significant?",
   "uso:answer": "Southern states used criminal convictions to lease mostly Black prisoners to private companies, as Georgia did from 1868 to 1908, and scholars still debate whether the framers meant the clause to permit that kind of forced labor.",
   "uso:questionFor": {
    "@id": "us:thirteenth-amendment"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/thirteenth-amendment/timeline/1",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Congress passes the Corwin Amendment, which would have shielded slavery in the states; it is never ratified.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1861"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/thirteenth-amendment/timeline/2",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The Emancipation Proclamation takes effect, but only in areas in rebellion.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1863-01-01"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/thirteenth-amendment/timeline/3",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The Senate Judiciary Committee under Lyman Trumbull reports the amendment to the full Senate.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1864-02-10"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/thirteenth-amendment/timeline/4",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The Senate passes the amendment, 38 to 6.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1864-04-08"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/thirteenth-amendment/timeline/5",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The House passes the amendment, 119 to 56, after earlier votes fell short.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1865-01-31"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/thirteenth-amendment/timeline/6",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Lincoln approves the joint resolution sending the amendment to the states.",
   "uso:date": {
