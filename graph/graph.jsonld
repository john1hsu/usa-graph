   "rdfs:label": "Dred Scott v. Sandford",
   "schema:startDate": {
    "@type": "xsd:date",
    "@value": "1857-03-06"
   },
   "skos:altLabel": [
    "19 How. 393",
    "60 U.S. 393",
    "Dred Scott case",
    "Dred Scott decision",
    "Dred Scott v Sandford",
    "Scott v. Sandford"
   ],
   "skos:broader": [
    {
     "@id": "us:sectionalism"
    },
    {
     "@id": "us:slavery-in-the-united-states"
    }
   ],
   "skos:definition": "The 1857 U.S. Supreme Court decision that rejected Dred Scott's claim to freedom, declared in Chief Justice Roger B. Taney's opinion that Black Americans could not be citizens of the United States, and struck down the Missouri Compromise's ban on slavery in federal territories.",
   "skos:inScheme": {
