  <https://github.com/john1hsu/usa-graph/id/stock-market-crash-of-1929/timeline/2> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://github.com/john1hsu/usa-graph/ontology#TimelineEntry> .
  <https://github.com/john1hsu/usa-graph/id/stock-market-crash-of-1929/timeline/2> <http://www.w3.org/2000/01/rdf-schema#label> "The Federal Reserve Board asks reserve banks to deny credit to member banks that lend to stock speculators." .
  <https://github.com/john1hsu/usa-graph/id/stock-market-crash-of-1929/timeline/2> <https://github.com/john1hsu/usa-graph/ontology#date> "1929-02-02"^^<http://www.w3.org/2001/XMLSchema#date> .
  <https://github.com/john1hsu/usa-graph/id/stock-market-crash-of-1929/timeline/3> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://github.com/john1hsu/usa-graph/ontology#TimelineEntry> .
  <https://github.com/john1hsu/usa-graph/id/stock-market-crash-of-1929/timeline/3> <http://www.w3.org/2000/01/rdf-schema#label> "The Board approves a rise in the New York Fed's discount rate to 6 percent." .
  <https://github.com/john1hsu/usa-graph/id/stock-market-crash-of-1929/timeline/3> <https://github.com/john1hsu/usa-graph/ontology#date> "1929-08"^^<http://www.w3.org/2001/XMLSchema#gYearMonth> .
  <https://github.com/john1hsu/usa-graph/id/stock-market-crash-of-1929/timeline/4> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://github.com/john1hsu/usa-graph/ontology#TimelineEntry> .
  <https://github.com/john1hsu/usa-graph/id/stock-market-crash-of-1929/timeline/4> <http://www.w3.org/2000/01/rdf-schema#label> "The Dow closes at its peak of 381.17." .
  <https://github.com/john1hsu/usa-graph/id/stock-market-crash-of-1929/timeline/4> <https://github.com/john1hsu/usa-graph/ontology#date> "1929-09-03"^^<http://www.w3.org/2001/XMLSchema#date> .
  <https://github.com/john1hsu/usa-graph/id/stock-market-crash-of-1929/timeline/5> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://github.com/john1hsu/usa-graph/ontology#TimelineEntry> .
  <https://github.com/john1hsu/usa-graph/id/stock-market-crash-of-1929/timeline/5> <http://www.w3.org/2000/01/rdf-schema#label> "Black Thursday: nearly 13 million shares trade; leading New York banks buy blue-chip stocks to steady prices." .
  <https://github.com/john1hsu/usa-graph/id/stock-market-crash-of-1929/timeline/5> <https://github.com/john1hsu/usa-graph/ontology#date> "1929-10-24"^^<http://www.w3.org/2001/XMLSchema#date> .
  <https://github.com/john1hsu/usa-graph/id/stock-market-crash-of-1929/timeline/6> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://github.com/john1hsu/usa-graph/ontology#TimelineEntry> .
  <https://github.com/john1hsu/usa-graph/id/stock-market-crash-of-1929/timeline/6> <http://www.w3.org/2000/01/rdf-schema#label> "President Hoover tells the press that the nation's basic business is sound." .
  <https://github.com/john1hsu/usa-graph/id/stock-market-crash-of-1929/timeline/6> <https://github.com/john1hsu/usa-graph/ontology#date> "1929-10-25"^^<http://www.w3.org/2001/XMLSchema#date> .
  <https://github.com/john1hsu/usa-graph/id/stock-market-crash-of-1929/timeline/7> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://github.com/john1hsu/usa-graph/ontology#TimelineEntry> .
  <https://github.com/john1hsu/usa-graph/id/stock-market-crash-of-1929/timeline/7> <http://www.w3.org/2000/01/rdf-schema#label> "Black Monday: the Dow falls nearly 13 percent." .
  <https://github.com/john1hsu/usa-graph/id/stock-market-crash-of-1929/timeline/7> <https://github.com/john1hsu/usa-graph/ontology#date> "1929-10-28"^^<http://www.w3.org/2001/XMLSchema#date> .
  <https://github.com/john1hsu/usa-graph/id/stock-market-crash-of-1929/timeline/8> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://github.com/john1hsu/usa-graph/ontology#TimelineEntry> .
  <https://github.com/john1hsu/usa-graph/id/stock-market-crash-of-1929/timeline/8> <http://www.w3.org/2000/01/rdf-schema#label> "Black Tuesday: the Dow falls nearly 12 percent on record trading of over 16 million shares." .
  <https://github.com/john1hsu/usa-graph/id/stock-market-crash-of-1929/timeline/8> <https://github.com/john1hsu/usa-graph/ontology#date> "1929-10-29"^^<http://www.w3.org/2001/XMLSchema#date> .
  <https://github.com/john1hsu/usa-graph/id/stock-market-crash-of-1929/timeline/9> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://github.com/john1hsu/usa-graph/ontology#TimelineEntry> .
