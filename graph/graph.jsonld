   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/winged-figures-of-the-republic/timeline/9",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Preservationists launch a Save the Star Map campaign after the terrazzo work stalls.",
