  <https://github.com/john1hsu/usa-graph/id/yellowstone-national-park/timeline/5> <http://www.w3.org/2000/01/rdf-schema#label> "The Senate passes S. 392." .
  <https://github.com/john1hsu/usa-graph/id/yellowstone-national-park/timeline/5> <https://github.com/john1hsu/usa-graph/ontology#date> "1872-01-30"^^<http://www.w3.org/2001/XMLSchema#date> .
  <https://github.com/john1hsu/usa-graph/id/yellowstone-national-park/timeline/6> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://github.com/john1hsu/usa-graph/ontology#TimelineEntry> .
  <https://github.com/john1hsu/usa-graph/id/yellowstone-national-park/timeline/6> <http://www.w3.org/2000/01/rdf-schema#label> "The House passes S. 392 by a vote of 115 to 65." .
  <https://github.com/john1hsu/usa-graph/id/yellowstone-national-park/timeline/6> <https://github.com/john1hsu/usa-graph/ontology#date> "1872-02-27"^^<http://www.w3.org/2001/XMLSchema#date> .
  <https://github.com/john1hsu/usa-graph/id/yellowstone-national-park/timeline/7> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://github.com/john1hsu/usa-graph/ontology#TimelineEntry> .
  <https://github.com/john1hsu/usa-graph/id/yellowstone-national-park/timeline/7> <http://www.w3.org/2000/01/rdf-schema#label> "President Ulysses S. Grant signs the Yellowstone National Park Protection Act." .
  <https://github.com/john1hsu/usa-graph/id/yellowstone-national-park/timeline/7> <https://github.com/john1hsu/usa-graph/ontology#date> "1872-03-01"^^<http://www.w3.org/2001/XMLSchema#date> .
  <https://github.com/john1hsu/usa-graph/id/yellowstone-national-park/timeline/8> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://github.com/john1hsu/usa-graph/ontology#TimelineEntry> .
  <https://github.com/john1hsu/usa-graph/id/yellowstone-national-park/timeline/8> <http://www.w3.org/2000/01/rdf-schema#label> "About 800 Nez Perce (Nimiipuu) people fleeing the U.S. Army enter the park and cross it in 13 days." .
  <https://github.com/john1hsu/usa-graph/id/yellowstone-national-park/timeline/8> <https://github.com/john1hsu/usa-graph/ontology#date> "1877-08-23"^^<http://www.w3.org/2001/XMLSchema#date> .
