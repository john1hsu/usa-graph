  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/harriet-tubman/timeline/2",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Probably marries John Tubman, a free Black man, and takes the name Harriet.",
   "uso:date": {
