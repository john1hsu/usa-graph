   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/thanksgiving/timeline/9",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Frank James (Wamsutta), an Aquinnah Wampanoag, speaks on Cole's Hill in Plymouth on Thanksgiving Day, beginning the annual National Day of Mourning.",
   "uso:date": {
