    "@value": "1905-06-23"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/huffman-prairie/timeline/6",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "A crash that throws Orville through the upper wing prompts a redesign of the controls.",
   "uso:date": {
