   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/obergefell-v-hodges/timeline/8",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The Court rules 5–4 that states must license and recognize same-sex marriages, overruling Baker v. Nelson.",
