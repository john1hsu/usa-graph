  {
   "@id": "https://github.com/john1hsu/usa-graph/id/hayden-geological-survey-of-1871/timeline/8",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The survey reaches Fort Bridger in southwestern Wyoming Territory.",
