   "@id": "https://github.com/john1hsu/usa-graph/id/deepwater-horizon-oil-spill/timeline/2",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The burning rig sinks in about 5,000 feet of water; aerial dispersant spraying begins the same day.",
