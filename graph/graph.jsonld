   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/winged-figures-of-the-republic/timeline/5",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The terrazzo floor receives its first repairs.",
   "uso:date": {
