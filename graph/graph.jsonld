   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/census-and-apportionment/timeline/12",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "In Department of Commerce v. Montana the Supreme Court upholds the equal-proportions method.",
   "uso:date": {
