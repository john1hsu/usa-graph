    "@value": "1913-08"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/triangle-shirtwaist-factory-fire/timeline/9",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Blanck and Harris settle 23 civil suits, paying $75 for each life lost.",
