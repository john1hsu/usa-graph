    "@value": "1908"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/harriet-tubman/timeline/15",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Dies of pneumonia in Auburn and is buried at Fort Hill Cemetery.",
   "uso:date": {
