  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/new-deal/timeline/8",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Roosevelt sends Congress a list of must-pass bills, opening the Second New Deal; that summer Congress passes the Wagner Act and the Social Security Act.",
