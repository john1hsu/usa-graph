  {
   "@id": "https://github.com/john1hsu/usa-graph/id/gilded-age/timeline/5",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Congress passes the Pendleton Civil Service Act, two years after President James Garfield's assassination.",
