   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/voting-rights-act-of-1965/timeline/11",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Congress renews the special provisions for 25 years and amends Section 2 so plaintiffs need not prove discriminatory purpose, responding to Mobile v. Bolden (1980).",
   "uso:date": {
