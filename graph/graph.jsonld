  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/constitutional-convention/misconception",
   "@type": "uso:Misconception",
   "uso:fact": "Congress called the meeting only to revise the Articles of Confederation and report proposed alterations to Congress and the states; the delegates decided on their own, by mid-June 1787, to draft an entirely new frame of government, and their Constitution took effect once nine state conventions had ratified it.",
   "uso:myth": "The delegates were sent to Philadelphia to write a new constitution.",
   "uso:why": "Because the convention's product replaced the Articles completely and is commemorated on September 17, it is easy to assume a new constitution was the assignment from the start, which hides how bold, and how contested, the delegates' decision was."
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/constitutional-convention/review/1",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why did the convention end up writing a whole new constitution when Congress had asked only for revisions?",
   "uso:answer": "Many delegates believed the Articles left the central government too weak; Randolph's Virginia Plan on May 29 proposed a new national legislature, executive and judiciary, and by mid-June the delegates had accepted that they were drafting a new frame of government rather than amending the old one.",
   "uso:questionFor": {
    "@id": "us:constitutional-convention"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/constitutional-convention/review/2",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "How did the Great Compromise settle the quarrel between large and small states?",
   "uso:answer": "It gave the House of Representatives seats in proportion to each state's population and gave every state equal representation in the Senate; it passed on July 16, 1787, by a single state's margin.",
   "uso:questionFor": {
    "@id": "us:constitutional-convention"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/constitutional-convention/review/3",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "How did the convention's decisions strengthen slaveholding states?",
   "uso:answer": "Counting three-fifths of enslaved people added to slave states' seats in the House and, through the electoral college, their weight in presidential elections; the convention also barred Congress from ending the Atlantic slave trade before 1808 and added a fugitive slave clause.",
   "uso:questionFor": {
    "@id": "us:constitutional-convention"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/constitutional-convention/review/4",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why do historians disagree about whether the Constitution was a proslavery document?",
   "uso:answer": "Paul Finkelman argues its many protections for slavery made it a proslavery bargain, while Sean Wilentz argues that by refusing to recognise property in people the framers left an opening later antislavery politicians used; critics of Wilentz note that his key Madison quotation may have been added to Madison's notes later.",
   "uso:questionFor": {
    "@id": "us:constitutional-convention"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/constitutional-convention/timeline/1",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The Confederation Congress calls a convention to meet in Philadelphia in May to revise the Articles of Confederation.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1787-02-21"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/constitutional-convention/timeline/10",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Congress unanimously resolves to send the Constitution to the states for ratifying conventions.",
   "uso:date": {
