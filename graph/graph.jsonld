  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/betsy-ross-flag-myth/timeline/2",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "She elopes with upholsterer John Ross and is expelled by the Quakers for marrying outside the meeting.",
   "uso:date": {
