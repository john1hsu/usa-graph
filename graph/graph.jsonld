  {
   "@id": "https://github.com/john1hsu/usa-graph/id/theodore-roosevelt/timeline/4",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "First travels to the Dakota Badlands, where he later ranches.",
   "uso:date": {
