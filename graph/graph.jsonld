    "@value": "1832"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/indian-removal-act/timeline/9",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "A minority Treaty Party signs the Treaty of New Echota without the authority of Principal Chief John Ross or the Cherokee government; the Second Seminole War begins the same year.",
   "uso:date": {
