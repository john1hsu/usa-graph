    "@value": "1865-12-06"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/thirteenth-amendment/timeline/8",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Secretary of State William H. Seward proclaims the amendment ratified.",
   "uso:date": {
