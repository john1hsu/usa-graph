  {
   "@id": "https://github.com/john1hsu/usa-graph/id/frederick-douglass/timeline/3",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Hired out to Edward Covey, a so-called slave breaker, and fights back against his beatings.",
