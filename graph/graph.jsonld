   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/constitutional-convention/timeline/3",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Seven states form a quorum and the delegates unanimously elect George Washington president of the convention.",
