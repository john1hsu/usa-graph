   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/department-of-homeland-security/timeline/9",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "FEMA and 21 other organizations formally join the department.",
