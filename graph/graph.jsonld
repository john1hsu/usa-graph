    "@value": "1978"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/yellowstone-national-park/timeline/14",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Wildfires burn about 36 percent of the park.",
   "uso:date": {
