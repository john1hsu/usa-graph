  {
   "@id": "https://github.com/john1hsu/usa-graph/id/blues/misconception",
   "@type": "uso:Misconception",
   "uso:fact": "Handy was a trained bandleader who encountered the blues already being played by Black musicians in the Mississippi Delta around 1903 — a slide guitarist at the Tutwiler station and a string band in Cleveland, Mississippi — and only then worked it into his repertoire. He wrote down and combined fragments of melodies and lyrics he heard from itinerant performers, arranged them as published songs, and made the music a national craze; the \"Father of the Blues\" title, which he used for his 1941 autobiography, honored him as its popularizer.",
   "uso:myth": "W. C. Handy, the \"Father of the Blues,\" invented the blues.",
   "uso:why": "Published sheet music, copyrights and an autobiography left a paper trail with Handy's name on it, while the unnamed rural musicians who created the music left almost no written record."
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/blues/review/1",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why is it misleading to say that W. C. Handy invented the blues?",
   "uso:answer": "Handy himself described hearing the blues from Black musicians in the Delta around 1903, before he played it; he wrote down and arranged fragments he heard from itinerant performers and published them, which made him the music's great popularizer rather than its creator.",
   "uso:questionFor": {
    "@id": "us:blues"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/blues/review/2",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "How did the blues change when Mississippi musicians moved to Chicago?",
   "uso:answer": "In the city they electrically amplified their instruments and added drums and horns, so the solo singer with a guitar became the blues band heard on labels such as Chess.",
   "uso:questionFor": {
    "@id": "us:blues"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/blues/review/3",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why did Mamie Smith's 1920 recording of \"Crazy Blues\" matter to the music business?",
   "uso:answer": "It was the first commercial vaudeville blues record by a Black singer, and in the following years \"race records\" — recordings by Black artists marketed mainly to Black buyers — grew into a business that sent scouts across the South and into northern cities to find blues talent.",
   "uso:questionFor": {
    "@id": "us:blues"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/blues/timeline/1",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "An English traveler describes the music of enslaved people on a Georgia rice plantation, an early account of music that would later evolve into the blues.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1839"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/blues/timeline/10",
