   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/jazz/timeline/12",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The State Department sends Dizzy Gillespie on the first of its Cold War jazz-ambassador tours.",
   "uso:date": {
    "@type": "xsd:gYearMonth",
    "@value": "1956-03"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/jazz/timeline/2",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Around this time uptown cornetist Charles \"Buddy\" Bolden begins improvising on the blues and speeding up dance tunes, a style many early musicians later called the first jazz.",
   "uso:date": {
