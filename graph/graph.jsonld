  {
   "@id": "https://github.com/john1hsu/usa-graph/id/theodore-roosevelt/timeline/15",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "A shooting in Brownsville, Texas, is blamed on Black soldiers of the 25th Infantry; Roosevelt later discharges 167 of them without honor or trial.",
   "uso:date": {
