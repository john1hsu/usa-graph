  {
   "@id": "https://github.com/john1hsu/usa-graph/id/abraham-lincoln/misconception",
   "@type": "uso:Misconception",
   "uso:fact": "Lincoln worked on the speech in the weeks before November 19, 1863; a Library of Congress copy begins in ink on Executive Mansion stationery written in Washington, and the drafts are in steady handwriting unlike a moving train's.",
   "uso:myth": "Lincoln dashed off the Gettysburg Address on the back of an envelope on the train to Gettysburg.",
   "uso:why": "The envelope story turns a carefully revised speech into a lucky improvisation and hides how deliberately Lincoln shaped his public words."
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/abraham-lincoln/review/1",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why did Lincoln win the presidency in 1860 with less than 40 percent of the popular vote?",
   "uso:answer": "Four major candidates split the vote; Lincoln carried every free state, which gave him 180 of 303 electoral votes, a clear Electoral College majority, even though he was not on the ballot in much of the South.",
   "uso:questionFor": {
    "@id": "us:abraham-lincoln"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/abraham-lincoln/review/2",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "How did the actions of enslaved people shape Lincoln's emancipation policy, according to historians such as Ira Berlin?",
   "uso:answer": "By fleeing to Union lines and offering labor and military service, enslaved people forced Union officers, Congress and the president to decide their status; Lincoln, who had first favored gradual, compensated emancipation and colonization, moved toward the Emancipation Proclamation as that pressure grew.",
   "uso:questionFor": {
    "@id": "us:abraham-lincoln"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/abraham-lincoln/review/3",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why do historians debate Lincoln's title of \"Great Emancipator\"?",
   "uso:answer": "Some see his leadership as the decisive force that ended slavery, while others argue he was a reluctant emancipator and that enslaved people were the prime movers; the debate is about how to weigh presidential leadership against the agency of the enslaved.",
   "uso:questionFor": {
    "@id": "us:abraham-lincoln"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/abraham-lincoln/timeline/1",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Born near Hodgenville, Kentucky.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1809-02-12"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/abraham-lincoln/timeline/10",
