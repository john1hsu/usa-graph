   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/roosevelt-corollary/timeline/2",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "British, German and Italian warships blockade Venezuela's ports after it defaults on debts to foreign bondholders.",
   "uso:date": {
