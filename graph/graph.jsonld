    "@value": "1823"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/monroe-doctrine/timeline/4",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Persuaded by Secretary of State John Quincy Adams, Monroe decides on a unilateral U.S. statement instead.",
   "uso:date": {
