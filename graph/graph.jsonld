   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/mississippi-river/timeline/5",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Confederate forces surrender Vicksburg, Mississippi, ending a campaign for control of the river.",
