   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/obergefell-v-hodges/timeline/4",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "United States v. Windsor requires the federal government to treat lawful same-sex marriages equally; dozens of federal courts then strike down state bans.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "2013"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/obergefell-v-hodges/timeline/5",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "A divided Sixth Circuit panel upholds the bans in Michigan, Ohio, Kentucky and Tennessee, reversing the trial courts.",
   "uso:date": {
    "@type": "xsd:gYearMonth",
    "@value": "2014-11"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/obergefell-v-hodges/timeline/6",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The Supreme Court agrees to hear the four consolidated cases.",
   "uso:date": {
