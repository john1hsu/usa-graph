   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/california-gold-rush/timeline/9",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "About 67,000 people arrive in California, 20,000 of them from China, the peak year; a new foreign miners' tax falls mainly on Chinese miners.",
