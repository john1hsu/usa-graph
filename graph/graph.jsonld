    "@value": "2015-01"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/obergefell-v-hodges/timeline/7",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The case is argued before the Supreme Court.",
   "uso:date": {
