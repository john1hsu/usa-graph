   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/tribal-sovereignty/misconception",
   "@type": "uso:Misconception",
   "uso:fact": "Federal law treats tribal self-government as inherent, held before the United States existed and acknowledged in treaties and the Constitution rather than created by them; tribal status is political, attaching to nations and their citizens, not to race.",
   "uso:myth": "Tribal sovereignty is a privilege the federal government granted to Native Americans as a racial group.",
   "uso:why": "Because Congress can limit tribal powers and federal agencies administer many tribal programs, sovereignty is easy to mistake for a federal gift, and because tribal citizens are Native people, a political status is easy to mistake for a racial one."
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/tribal-sovereignty/review/1",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why did the Supreme Court in Worcester v. Georgia hold that Georgia's laws could not reach the Cherokee Nation?",
   "uso:answer": "Chief Justice John Marshall reasoned that Indian nations had always been distinct, independent political communities whose relations with the United States ran through treaties and federal law, so the Cherokee Nation was a distinct community occupying its own territory where state law had no force, and the Georgia statute used to convict Samuel Worcester was void.",
   "uso:questionFor": {
    "@id": "us:tribal-sovereignty"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/tribal-sovereignty/review/2",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "How is tribal sovereignty both inherent and limited under federal law?",
   "uso:answer": "The Court treats tribal powers as inherent, existing before and apart from the United States, yet it has also held that Congress has broad (plenary but not absolute) power over Indian affairs and can restrict tribal authority, as when courts held tribes lack criminal jurisdiction over non-Indians without congressional authorization.",
   "uso:questionFor": {
    "@id": "us:tribal-sovereignty"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/tribal-sovereignty/review/3",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "How did termination policy in the 1950s and 1960s run against the principle of tribal sovereignty?",
   "uso:answer": "Termination sought to end federal recognition and trust protection of tribes and shifted reservation jurisdiction to states; Congress began 60 termination proceedings and more than three million acres of tribal land were lost before the policy was repudiated in 1970 in favor of self-determination.",
   "uso:questionFor": {
    "@id": "us:tribal-sovereignty"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/tribal-sovereignty/timeline/1",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The United States signs its first treaty with a Native nation, the Lenape (Delaware); both sides treat early treaties as diplomatic agreements between sovereigns.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1778"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/tribal-sovereignty/timeline/10",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "California v. Cabazon Band of Mission Indians holds that state regulation of on-reservation bingo would infringe tribal government.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1987"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/tribal-sovereignty/timeline/11",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "McGirt v. Oklahoma holds that only Congress, by clear statement, can disestablish a reservation.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "2020"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/tribal-sovereignty/timeline/2",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "In Cherokee Nation v. Georgia the Supreme Court calls tribes \"domestic dependent nations\" and declines to hear the Cherokee suit.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1831"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/tribal-sovereignty/timeline/3",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "In Worcester v. Georgia the Court holds that Georgia law has no force within the Cherokee Nation.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1832"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/tribal-sovereignty/timeline/4",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Congress forbids further treaty-making with tribes; more than 370 ratified treaties remain law.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1871"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/tribal-sovereignty/timeline/5",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "United States v. Kagama upholds federal criminal laws on reservations as a power to protect dependent peoples.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1886"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/tribal-sovereignty/timeline/6",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "House Concurrent Resolution 108 announces the policy of terminating federal supervision of tribes.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1953-08-01"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/tribal-sovereignty/timeline/7",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Public Law 280 shifts criminal and civil jurisdiction on most reservations in five states to state authorities.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1953-08-15"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/tribal-sovereignty/timeline/8",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The Nixon administration repudiates termination and turns federal policy toward tribal self-determination.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1970"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/tribal-sovereignty/timeline/9",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "United States v. Wheeler describes tribal powers as inherent; Oliphant v. Suquamish Indian Tribe denies tribes criminal jurisdiction over non-Indians.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1978"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/underground-railroad/misconception",
   "@type": "uso:Misconception",
   "uso:fact": "Historians describe it as an interlocking series of local networks; most flight was started by enslaved people themselves, many escaped with no help at all, free and enslaved Black people were central helpers, and studies of runaway advertisements suggest only a small share of runaways used organized aid.",
   "uso:myth": "The Underground Railroad was a single, centrally run system of \"stations\" and \"conductors\" operated mainly by white abolitionists who carried most escapees to freedom.",
   "uso:why": "Abolitionists and enslavers both had reasons to exaggerate its organization, and late-nineteenth-century reminiscences and Wilbur Siebert's 1898 route maps fixed that image in popular memory."
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/underground-railroad/review/1",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "How did the Fugitive Slave Act of 1850 change the Underground Railroad?",
   "uso:answer": "By commanding bystanders to help catch freedom seekers, denying alleged fugitives the right to testify and fining or jailing anyone who helped them, it made even the free states unsafe, so aid became more deliberate and organized and more freedom seekers pushed on to Canada.",
   "uso:questionFor": {
    "@id": "us:underground-railroad"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/underground-railroad/review/2",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why did Larry Gara's 1961 book change how historians understood the Underground Railroad?",
   "uso:answer": "Gara argued that Siebert's account rested on embellished memories and that freedom seekers mostly crossed the South on their own, so he shifted the focus from white \"conductors\" to the courage of enslaved people and the free Black communities who helped them.",
   "uso:questionFor": {
    "@id": "us:underground-railroad"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/underground-railroad/review/3",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why do some historians think most runaways never used the Underground Railroad?",
   "uso:answer": "John Hope Franklin and Loren Schweninger's study of runaway advertisements found that most runaways hid in nearby woods or towns and returned within days or weeks, so only a small portion reached organized networks in the North.",
   "uso:questionFor": {
    "@id": "us:underground-railroad"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/underground-railroad/timeline/1",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Congress passes the first federal fugitive slave law, letting enslavers seize freedom seekers even in free states.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1793"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/underground-railroad/timeline/10",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "William Still publishes The Underground Railroad, based on his Philadelphia vigilance committee records.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1872"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/underground-railroad/timeline/11",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Wilbur H. Siebert publishes The Underground Railroad from Slavery to Freedom, long the standard account.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1898"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/underground-railroad/timeline/12",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Larry Gara's The Liberty Line challenges the legend and recentres freedom seekers themselves.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1961"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/underground-railroad/timeline/13",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The National Underground Railroad Network to Freedom Act (Public Law 105-203) creates a National Park Service commemoration program.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1998-07-21"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/underground-railroad/timeline/14",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Eric Foner's Gateway to Freedom documents New York's interracial vigilance committees.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "2015"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/underground-railroad/timeline/2",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Tice Davids crosses the Ohio River from Kentucky; folklore says his enslaver claimed he had vanished on an underground road, one of several legends about the name.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1831"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/underground-railroad/timeline/3",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Robert Purvis brings a vigilance committee to Philadelphia to aid freedom seekers.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "1837"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/underground-railroad/timeline/4",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Prigg v. Pennsylvania upholds the 1793 law but frees state officials from enforcing it; the phrase underground railroad appears in the New York Spectator.",
   "uso:date": {
