   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/winged-figures-of-the-republic/timeline/4",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Hansen is photographed at the figures with Carl J. Hambro, president of the Norwegian Parliament.",
   "uso:date": {
