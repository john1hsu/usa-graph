    "@value": "1902"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/theodore-roosevelt/timeline/12",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The Supreme Court upholds the government's antitrust suit against the Northern Securities Company; Roosevelt wins a full term in a landslide.",
   "uso:date": {
