   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/covid-19-pandemic-in-the-united-states/misconception",
   "@type": "uso:Misconception",
   "uso:fact": "CDC estimates about 675,000 U.S. deaths in the 1918 pandemic, while recorded U.S. COVID-19 deaths reached 1 million by May 12, 2022, so in raw numbers COVID-19 was the deadlier outbreak in American history.",
   "uso:myth": "The 1918 influenza pandemic killed more Americans than any other pandemic, including COVID-19.",
   "uso:why": "The 1918 flu has long been remembered as the benchmark for a catastrophic pandemic, and the comparison is easy to miss because the two tolls were counted a century apart in a much smaller and a much larger country."
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/covid-19-pandemic-in-the-united-states/review/1",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why did the federal government declare emergencies in early 2020, and what did that make possible?",
   "uso:answer": "After the first confirmed case on January 20, HHS declared a public health emergency on January 31 and the administration declared a nationwide emergency on March 13, which gave federal agencies emergency powers that later supported free testing, Medicaid and Medicare flexibilities, and emergency use authorizations for vaccines.",
   "uso:questionFor": {
    "@id": "us:covid-19-pandemic-in-the-united-states"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/covid-19-pandemic-in-the-united-states/review/2",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "How did the pandemic affect the U.S. labor market in spring 2020?",
   "uso:answer": "Efforts to contain the virus shut down much of the economy, so in April 2020 payroll employment fell by 20.5 million and unemployment reached 14.7 percent, the highest rate and largest one-month rise in the series dating to 1948, with leisure and hospitality hit hardest.",
   "uso:questionFor": {
    "@id": "us:covid-19-pandemic-in-the-united-states"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/covid-19-pandemic-in-the-united-states/review/3",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why did U.S. life expectancy fall in both 2020 and 2021, and which group lost the most?",
   "uso:answer": "COVID-19 deaths accounted for about three-quarters of the 2020 decline and half of the 2021 decline; American Indian and Alaska Native people lost the most, 6.6 years between 2019 and 2021.",
   "uso:questionFor": {
    "@id": "us:covid-19-pandemic-in-the-united-states"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/covid-19-pandemic-in-the-united-states/review/4",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "What changed, and what did not, when the public health emergency ended on May 11, 2023?",
   "uso:answer": "Requirements that Medicare and private insurers cover COVID-19 tests without cost sharing ended and some reporting authority lapsed, but vaccines stayed free, treatments stayed available, and existing emergency use authorizations were unaffected.",
   "uso:questionFor": {
    "@id": "us:covid-19-pandemic-in-the-united-states"
   }
  },
