   "rdfs:label": "Monroe Doctrine",
   "schema:startDate": {
    "@type": "xsd:date",
    "@value": "1823-12-02"
   },
   "skos:altLabel": "Monroe Doctrine of 1823",
   "skos:broader": {
    "@id": "us:foreign-relations-of-the-united-states"
   },
   "skos:definition": "The foreign-policy principles President James Monroe set out in his annual message to Congress on December 2, 1823: that the Americas were closed to new European colonization, that European intervention in the independent states of the hemisphere would be seen as a threat to the United States, and that the United States would stay out of European affairs and existing European colonies.",
   "skos:inScheme": {
    "@id": "https://github.com/john1hsu/usa-graph/id/scheme/early-republic-and-expansion"
   },
