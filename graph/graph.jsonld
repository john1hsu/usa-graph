   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/jamestown/misconception",
   "@type": "uso:Misconception",
   "uso:fact": "Spain founded St. Augustine, Florida, in 1565, forty-two years before Jamestown, and it remains the oldest continuously occupied European settlement in the continental United States; Jamestown was the first permanent English settlement in North America.",
   "uso:myth": "Jamestown was the first European settlement in what is now the United States.",
   "uso:why": "National memory has long traced the country's origins through the English colonies, which pushes the earlier Spanish presence in Florida and the Southwest, and the Native nations already there, out of the founding story."
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/jamestown/review/1",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why did Jamestown's survival in its first years depend on the Powhatans?",
   "uso:answer": "Disease, bad water, famine and war killed many colonists, and Powhatan sent food to the struggling fort; the National Park Service judges that without Powhatan help the settlement would most likely have failed, and when trade broke down in 1609 the Starving Time followed.",
   "uso:questionFor": {
    "@id": "us:jamestown"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/jamestown/review/2",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "How did tobacco change Jamestown and Virginia?",
   "uso:answer": "After John Rolfe introduced a new tobacco strain in 1612 it became the colony's cash crop, which drew more colonists, drove expansion onto Powhatan land that led to the 1622 and 1644 wars, and created the demand for labor that brought the first documented enslaved Africans in 1619.",
   "uso:questionFor": {
    "@id": "us:jamestown"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/jamestown/review/3",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why is Jamestown not the first European settlement in the United States, and what is it the first of?",
   "uso:answer": "Spain founded St. Augustine in 1565, forty-two years earlier; Jamestown was the first permanent English settlement in North America and the site of English America's first representative legislative assembly in 1619.",
   "uso:questionFor": {
    "@id": "us:jamestown"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/jamestown/timeline/1",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "King James I grants the Virginia Company of London a royal charter to colonize Virginia.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1606-04-10"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/jamestown/timeline/10",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Opechancanough's coordinated attack kills 350 to 400 of about 1,200 colonists; Jamestown itself is warned and spared.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1622-03-22"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/jamestown/timeline/11",
