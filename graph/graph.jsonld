   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/fourteenth-amendment/timeline/3",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The Senate passes the amendment, 33 to 11.",
