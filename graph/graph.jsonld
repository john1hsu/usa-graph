   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/new-deal/timeline/9",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "In United States v. Butler the Supreme Court strikes down the Agricultural Adjustment Act's processing tax.",
