   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/wright-company-school-of-aviation/timeline/5",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Army lieutenants Henry H. Arnold and Thomas DeW. Milling and Lt. John Rodgers arrive in Dayton for lessons.",
   "uso:date": {
    "@type": "xsd:date",
