   "@id": "https://github.com/john1hsu/usa-graph/id/louisiana-purchase/timeline/4",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Jefferson sends James Monroe as minister extraordinary to join Robert Livingston in Paris, authorized to pay up to $10 million for New Orleans and the Floridas.",
