  {
   "@id": "https://github.com/john1hsu/usa-graph/id/declaration-of-independence/misconception",
   "@type": "uso:Misconception",
   "uso:fact": "Congress approved the text on July 4, but it ordered a parchment copy for signing only on July 19; most delegates signed on August 2, 1776, a few signed later that year, and Thomas McKean signed sometime after January 1777.",
   "uso:myth": "The delegates signed the Declaration of Independence on July 4, 1776.",
   "uso:why": "Later recollections by Jefferson and Adams placed the signing on July 4, and the copies printed that week carried only the names of John Hancock and Charles Thomson, so the date of approval and the act of signing blurred together in popular memory."
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/declaration-of-independence/review/1",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why did Congress cut Jefferson's passage blaming the king for the slave trade?",
   "uso:answer": "Jefferson recorded that it was struck to accommodate South Carolina and Georgia, which wanted the slave trade to continue, and that some Northern delegates were uneasy because Northern merchants had carried enslaved people; the deletion kept those delegations behind independence.",
   "uso:questionFor": {
    "@id": "us:declaration-of-independence"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/declaration-of-independence/review/2",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "How did declaring independence help the American war effort abroad?",
   "uso:answer": "France would consider a formal alliance only once the colonies declared independence, so the Declaration opened the way to recognition and to the 1778 Treaty of Alliance with France, followed by Dutch recognition in 1782 and British acknowledgement in the 1783 Treaty of Paris.",
   "uso:questionFor": {
    "@id": "us:declaration-of-independence"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/declaration-of-independence/review/3",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why is July 4 not the day the Declaration was signed?",
   "uso:answer": "July 4 was the day Congress approved the text; the signing copy was only ordered on July 19, and most delegates signed it on August 2, 1776, with others signing later.",
   "uso:questionFor": {
    "@id": "us:declaration-of-independence"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/declaration-of-independence/review/4",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "How did later reformers use the Declaration's language?",
   "uso:answer": "The women who met at Seneca Falls in 1848 modelled their Declaration of Sentiments on it, declaring that all men and women are created equal, and Frederick Douglass in 1852 measured the nation's celebration of independence against the slavery it still allowed.",
   "uso:questionFor": {
    "@id": "us:declaration-of-independence"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/declaration-of-independence/timeline/1",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Richard Henry Lee of Virginia moves in Congress that the colonies are, and ought to be, free and independent states.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1776-06-07"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/declaration-of-independence/timeline/2",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The drafting committee presents Jefferson's draft, edited by Adams and Franklin, to Congress.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1776-06-28"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/declaration-of-independence/timeline/3",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "A first vote on Lee's resolution: nine colonies in favour, Pennsylvania and South Carolina opposed, Delaware deadlocked and New York abstaining.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1776-07-01"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/declaration-of-independence/timeline/4",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Twelve colonies vote for independence, with New York abstaining.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1776-07-02"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/declaration-of-independence/timeline/5",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Congress approves the revised text and orders it printed; John Dunlap prints about 200 broadsides.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1776-07-04"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/declaration-of-independence/timeline/6",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "John Nixon gives the first public reading in the State House Yard in Philadelphia.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1776-07-08"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/declaration-of-independence/timeline/7",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Congress orders the text engrossed on parchment under a new title for members to sign.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1776-07-19"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/declaration-of-independence/timeline/8",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "John Hancock and most of the delegates sign the engrossed parchment.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1776-08-02"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/declaration-of-independence/timeline/9",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Congress authorizes a printing that carries the signers' names for the first time.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "1777-01-18"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/department-of-homeland-security/misconception",
   "@type": "uso:Misconception",
   "uso:fact": "The FBI and CIA stayed outside the new department; the 2002 act transferred only the FBI's National Infrastructure Protection Center and allowed FBI and CIA analysts to be detailed to DHS, and President Bush considered folding in the FBI but decided against it.",
   "uso:myth": "The Department of Homeland Security took over the FBI and the CIA when it was created.",
   "uso:why": "The department was sold as the answer to the intelligence-sharing failures before 9/11, so many people assume it absorbed the main intelligence agencies; the later Director of National Intelligence and counterterrorism center were separate reforms."
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/department-of-homeland-security/review/1",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why did the Bush administration move from a White House office to a full Cabinet department for homeland security?",
   "uso:answer": "The Office of Homeland Security created in October 2001 coordinated agencies but many observers doubted it had the authority to overcome bureaucratic obstacles; with Congress already drafting a department bill, Bush reversed course in June 2002 and proposed a permanent department that would combine the agencies directly.",
   "uso:questionFor": {
    "@id": "us:department-of-homeland-security"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/department-of-homeland-security/review/2",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "How did the creation of DHS change the federal government's handling of immigration?",
   "uso:answer": "The act abolished the Justice Department's Immigration and Naturalization Service and split its work among three DHS agencies — Customs and Border Protection, Immigration and Customs Enforcement and U.S. Citizenship and Immigration Services — separating enforcement from the processing of visas and naturalization.",
   "uso:questionFor": {
    "@id": "us:department-of-homeland-security"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/department-of-homeland-security/review/3",
   "@type": "uso:ReviewQuestion",
   "rdfs:label": "Why did Congress reorganize FEMA in 2006?",
   "uso:answer": "The response to Hurricane Katrina in August 2005 exposed gaps in federal emergency management, so the Post-Katrina Emergency Management Reform Act gave FEMA substantial new authority and a stronger preparedness mission within the department.",
   "uso:questionFor": {
    "@id": "us:department-of-homeland-security"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/department-of-homeland-security/timeline/1",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The Hart-Rudman Commission proposes a National Homeland Security Agency to consolidate nearly two dozen agencies.",
   "uso:date": {
    "@type": "xsd:gYearMonth",
    "@value": "2001-01"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/department-of-homeland-security/timeline/10",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Secretary Michael Chertoff's Second Stage Review leads to a major internal reorganization.",
   "uso:date": {
    "@type": "xsd:gYear",
    "@value": "2005"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/department-of-homeland-security/timeline/11",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Bush signs the Post-Katrina Emergency Management Reform Act, reorganizing FEMA after Hurricane Katrina.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "2006-10-04"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/department-of-homeland-security/timeline/12",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The Cybersecurity and Infrastructure Security Agency Act creates CISA within the department.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "2018-11-16"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/department-of-homeland-security/timeline/2",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Executive Order 13228 creates the White House Office of Homeland Security and the Homeland Security Council.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "2001-10-08"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/department-of-homeland-security/timeline/3",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "Senator Joseph Lieberman introduces S. 1534, an early bill for a homeland security department.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "2001-10-11"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/department-of-homeland-security/timeline/4",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "President George W. Bush, reversing his earlier position, proposes a Cabinet-level department in an address to the nation.",
   "uso:date": {
    "@type": "xsd:date",
    "@value": "2002-06-06"
   }
  },
  {
   "@id": "https://github.com/john1hsu/usa-graph/id/department-of-homeland-security/timeline/5",
   "@type": "uso:TimelineEntry",
   "rdfs:label": "The House passes H.R. 5005, 295–132.",
   "uso:date": {
    "@type": "xsd:date",
